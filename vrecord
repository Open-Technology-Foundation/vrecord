#!/usr/bin/env bash
#shellcheck disable=SC2155,SC1090,SC1091,SC2119,SC2120,SC2034
# vrecord - Voice Recorder with Resume Capability
# Copyright (C) 2024-2025 Open Technology Foundation
# License: GPL-3.0-or-later <https://gnu.org/licenses/gpl.html>
#
# Command-line voice recorder for Linux with:
#   - Pause/resume: pause ends the current segment, resume records a new one
#   - Continue/append to existing WAV recordings
#   - Automatic MP3 conversion (libmp3lame)
#   - Optional transcription integration
#   - Playback of recordings via xdg-open
#
# Dependencies: ffmpeg (PulseAudio), pactl | Optional: mediainfo, transcribe, xdg-open
#
set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

# Lock PATH to standard locations so the external tools this script runs
# (ffmpeg, pactl, ffplay, mediainfo, transcribe) cannot be hijacked via a
# rogue binary earlier in an inherited PATH.
declare -rx PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Script metadata
declare -r VERSION=1.2.0
#shellcheck disable=SC2155
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_DIR=${SCRIPT_PATH%/*} SCRIPT_NAME=${SCRIPT_PATH##*/}

# ============================================================================
# LOGGING AND OUTPUT
# Provides colored, level-based messaging (info/warn/error/debug/success)
# ============================================================================
declare -i VERBOSE=1 DEBUG=0
# Standard colours
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
fi
# Core message function using FUNCNAME for context
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    success) prefix+=" ${GREEN}✓${NC}" ;;
    warn)    prefix+=" ${YELLOW}▲${NC}" ;;
    info)    prefix+=" ${CYAN}◉${NC}" ;;
    error)   prefix+=" ${RED}✗${NC}" ;;
    debug)   prefix+=" ${YELLOW}⦿${NC}" ;;
    *)       ;;
  esac
  for msg in "$@"; do printf '%s %s\n' "$prefix" "$msg"; done
}
# Conditional output based on verbosity
success() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
warn() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
info() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
debug() { ((DEBUG)) || return 0; >&2 _msg "$@"; }
# Unconditional output
error() { >&2 _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# ============================================================================
# SECURITY AND VALIDATION
# Input sanitization to prevent path traversal, injection, and shell exploits
# ============================================================================

# validate_safe_filename: Reject filenames with dangerous characters or patterns
# Rules: alphanumeric, dots, underscores, hyphens only; no leading dash; no ..
# Args: $1=filename, $2=allow_path (0=filename only, 1=allow /)
validate_safe_filename() {
  local -- filename=$1
  local -i allow_path=${2:-0}  # Allow paths with slashes

  # Check for empty filename
  if [[ -z "$filename" ]]; then
    error 'Filename cannot be empty'
    return 1
  fi

  # Check length (255 for filename, longer for full paths)
  local -i max_length=255
  ((allow_path==0)) || max_length=4096
  if ((${#filename} > max_length)); then
    error "Filename too long (max $max_length characters)"
    return 1
  fi

  # Check for directory traversal
  if [[ "$filename" =~ \.\. ]]; then
    error 'Directory traversal not allowed in filename'
    return 1
  fi

  # Check for null bytes
  if [[ "$filename" != "${filename//$'\x00'/}" ]]; then
    error 'Null bytes not allowed in filename'
    return 1
  fi

  # Validate characters based on whether paths are allowed
  if ((allow_path)); then
    # Allow alphanumeric, dots, underscores, hyphens, and forward slashes
    if [[ "$filename" =~ [^a-zA-Z0-9._/-] ]]; then
      error 'Unsafe characters in filename. Only alphanumeric, dots, underscores, hyphens and slashes allowed.'
      return 1
    fi
  else
    # Disallow slashes for pure filenames
    if [[ "$filename" =~ [^a-zA-Z0-9._-] ]]; then
      error 'Unsafe characters in filename. Only alphanumeric, dots, underscores and hyphens allowed.'
      return 1
    fi
  fi

  # Check for shell metacharacters and other dangerous characters
  if [[ "$filename" =~ [\$\`\(\)\{\}\[\]\<\>\|\&\;\'\"\*\?\\] ]]; then
    error 'Shell metacharacters not allowed in filename'
    return 1
  fi

  # Check for leading dash (could be interpreted as option)
  if [[ "$filename" =~ ^- ]]; then
    error 'Filename cannot start with dash'
    return 1
  fi

  return 0
}

# validate_recording_path: Ensure file path is within RECORDING_DIR
# Prevents directory traversal attacks by comparing canonical paths
validate_recording_path() {
  local -- filepath=$1

  # Get absolute paths for comparison
  local -- abs_path abs_recording_dir
  abs_path=$(realpath -- "$filepath" 2>/dev/null) || abs_path="$filepath"
  abs_recording_dir=$(realpath -- "$RECORDING_DIR" 2>/dev/null) || abs_recording_dir=$(realpath "$RECORDING_DIR" 2>/dev/null) || abs_recording_dir="$RECORDING_DIR"

  # Must be under RECORDING_DIR
  if [[ "$abs_path" != "$abs_recording_dir"/* ]] && [[ "$abs_path" != "$abs_recording_dir" ]]; then
    error "File must be within recording directory ${RECORDING_DIR@Q}"
    return 1
  fi

  return 0
}

# ============================================================================
# CONFIGURATION
# Settings with defaults; overridden by config files, then VRECORD_* env vars
# ============================================================================

# Recording parameters - directory paths and audio settings
declare -- RECORDING_DIR=${RECORDING_DIR:-$HOME/Recordings}  # Where WAV/MP3 files are saved
declare -- STATE_DIR=${STATE_DIR:-$HOME/.vrecord}            # Persistent state (config, beep.mp3)
declare -- DEFAULT_PREFIX=${DEFAULT_PREFIX:-voice_recording} # Filename prefix when none specified
declare -- MP3_BITRATE=${MP3_BITRATE:-192k}                  # libmp3lame bitrate
declare -- AUDIO_FORMAT=${AUDIO_FORMAT:-pcm_s16le}           # WAV codec (16-bit PCM)
declare -i SAMPLE_RATE=${SAMPLE_RATE:-44100}                 # Audio sample rate (Hz)
declare -i CHANNELS=${CHANNELS:-2}                           # Mono (1) or stereo (2)
declare -i MIN_DISK_SPACE_MB=${MIN_DISK_SPACE_MB:-100}       # Minimum free space to start
declare -i LOG_MAX_SIZE_MB=${LOG_MAX_SIZE_MB:-10}            # Rotate logs when exceeded
declare -i LOG_MAX_FILES=${LOG_MAX_FILES:-5}                 # Keep N rotated log files

# Beep notifications - periodic audio reminder during recording
declare -i BEEP_ENABLED=${BEEP_ENABLED:-1}                   # 1=enabled, 0=disabled
declare -i BEEP_INTERVAL=${BEEP_INTERVAL:-60}                # Seconds between beeps
declare -- BEEP_FILE=${BEEP_FILE:-"$STATE_DIR"/beep.mp3}     # Sound file path

# Runtime state - initialized during execution
declare -- SESSION_DIR=''  # Session dir: $STATE_DIR/session (set by init_session)
declare -- MERGE_TEMP=''   # Merge output being written; cleanup_on_exit removes it
declare -- PID_FILE STATE_FILE SEGMENT_COUNT_FILE SEGMENTS_DIR LOCK_FILE BEEP_PID_FILE TRANSCRIBE_FILE NO_MP3_FILE

# Command-line flags - set by option parsing
declare -i NO_MP3=0      # --no-mp3: skip MP3 conversion
declare -i NO_BEEP=0     # --no-beep: suppress beep notifications
declare -i TRANSCRIBE=0  # --transcribe: run transcription after MP3

# load_config: Source a config file if it exists and is valid
load_config() {
  local -- config_file=$1
  if [[ -f "$config_file" ]]; then
    debug "Loading config from ${config_file@Q}"
    # Validate syntax in subshell before sourcing
    if (source "$config_file" 2>/dev/null); then
      source "$config_file"
    else
      warn "Invalid config file ${config_file@Q}"
    fi
  fi
}

# Configuration precedence (highest to lowest):
#   1. VRECORD_* environment variables
#   2. User config: ~/.vrecord/config
#   3. System config: /etc/vrecord/config
#   4. Built-in defaults (above)
load_config /etc/vrecord/config
load_config "$STATE_DIR"/config

# Environment variable overrides (VRECORD_* prefix)
RECORDING_DIR=${VRECORD_RECORDING_DIR:-$RECORDING_DIR}
STATE_DIR=${VRECORD_STATE_DIR:-$STATE_DIR}
DEFAULT_PREFIX=${VRECORD_DEFAULT_PREFIX:-$DEFAULT_PREFIX}
MP3_BITRATE=${VRECORD_MP3_BITRATE:-$MP3_BITRATE}

# Derived paths
LOCK_FILE="$STATE_DIR"/vrecord.lock

# Create directories if they don't exist
mkdir -p "$RECORDING_DIR" "$STATE_DIR"

# ============================================================================
# DEPENDENCY CHECKS
# Verify required tools (ffmpeg with PulseAudio, pactl) are available
# ============================================================================
check_dependencies() {
  local -i missing=0
  
  if ! command -v ffmpeg &>/dev/null; then
    error 'ffmpeg is not installed!'
    missing+=1
  elif ! ffmpeg -hide_banner -devices 2>&1 | grep -q 'pulse'; then
    error 'ffmpeg does not have PulseAudio support!'
    missing+=1
  fi
  
  if ! command -v pactl &>/dev/null; then
    error 'PulseAudio is not installed!'
    missing+=1
  fi
  
  ((missing == 0)) || die 1 'Missing dependencies. Please install required software.'
}

# ============================================================================
# LOCK FILE MANAGEMENT
# Prevents concurrent vrecord instances via exclusive file locking
# ============================================================================

# acquire_lock: Obtain exclusive lock using flock (preferred) or atomic mv
# Uses flock(1) for file descriptor locking when available; falls back to
# atomic rename operations with stale lock detection for portability
# Args: $1=timeout_seconds (default: 5)
acquire_lock() {
  local -i timeout=${1:-5}
  
  # Ensure lock directory exists
  local -- lock_dir=${LOCK_FILE%/*}
  [[ -d "$lock_dir" ]] || mkdir -p "$lock_dir" || {
    error "Cannot create lock directory ${lock_dir@Q}"
    return 1
  }
  
  if command -v flock &>/dev/null; then
    # Use flock for atomic locking via file descriptor
    debug 'Using flock for lock management'

    # Open file descriptor 9 for the lock file
    exec 9>"$LOCK_FILE" || {
      error "Cannot open lock file ${LOCK_FILE@Q}"
      return 1
    }

    # Try to acquire exclusive lock with timeout
    if flock -n -w "$timeout" 9; then
      # Write PID to lock file for debugging/stale detection
      echo $$ > "$LOCK_FILE"
      debug 'Lock acquired using flock'
      return 0
    else
      exec 9>&-  # Close file descriptor on failure
      error "Another instance is running (timeout after ${timeout}s)"
      return 1
    fi
  else
    # Fallback: Use atomic file operations
    debug 'Using atomic file operations for lock management'

    local -- temp_lock="$LOCK_FILE.$$"
    local -i elapsed=0

    # Write PID to temp file
    echo $$ > "$temp_lock" 2>/dev/null || {
      error 'Cannot create temporary lock file'
      return 1
    }

    # Try to acquire lock with timeout
    while ((elapsed < timeout)); do
      # Try atomic move (only succeeds if target doesn't exist)
      if mv -n "$temp_lock" "$LOCK_FILE" 2>/dev/null; then
        debug 'Lock acquired using atomic move'
        return 0
      fi

      # Check if existing lock is stale
      local -- lock_pid=$(cat "$LOCK_FILE" 2>/dev/null)
      if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
        warn "Removing stale lock file (PID: $lock_pid)"
        rm -f "$LOCK_FILE"
        # Recreate temp file if needed
        [[ -f "$temp_lock" ]] || echo $$ > "$temp_lock" 2>/dev/null
        continue
      fi

      sleep 1
      elapsed+=1
    done

    # Cleanup temp file
    rm -f "$temp_lock"

    error "Another instance is running (PID: $(cat "$LOCK_FILE" 2>/dev/null || echo 'unknown'))"
    return 1
  fi
}

release_lock() {
  if command -v flock &>/dev/null; then
    # flock branch: the lock lives on the open file descriptor (FD 9), not on
    # the path. Drop the advisory lock and close the FD; do NOT unlink the file.
    # Unlinking a flock-held path lets a concurrent instance open a fresh inode
    # and lock it immediately, silently breaking mutual exclusion (and it also
    # leaked FD 9). flock/exec on an unopened FD 9 are harmless no-ops.
    flock -u 9 2>/dev/null || true
    exec 9>&-
    debug 'Lock released (flock)'
  elif [[ -f "$LOCK_FILE" ]]; then
    # Atomic-mv fallback: here the lock IS the file's existence. Remove it,
    # but only if this process still owns it.
    local -- lock_pid=''
    lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo '')
    if [[ "$lock_pid" == "$$" ]]; then
      rm -f "$LOCK_FILE"
      debug 'Lock released (atomic)'
    else
      warn "Not releasing lock - owned by different process (PID: ${lock_pid:-unknown})"
    fi
  fi
}

# ============================================================================
# CLEANUP AND SIGNAL HANDLING
# Graceful shutdown: release locks, preserve active recordings if running
# ============================================================================
cleanup_on_exit() {
  local -- exit_code=$?
  # Disarm traps so the exit below cannot re-enter this handler via the EXIT
  # trap (signal -> cleanup_on_exit -> exit -> EXIT trap -> cleanup_on_exit).
  trap - INT TERM EXIT

  # An interrupted merge: its partial output is useless (the original and the
  # segments are untouched, so 'stop' can simply run again) and its random
  # name would never be reused, so it would sit beside the recordings forever.
  [[ -z "$MERGE_TEMP" ]] || rm -f -- "$MERGE_TEMP"

  # If we have an active recording PID, try to save it gracefully
  if [[ -n "$SESSION_DIR" && -f "$SESSION_DIR"/ffmpeg.pid ]]; then
    local -- pid=$(cat -- "$SESSION_DIR"/ffmpeg.pid 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      warn 'Recording continues in background'
      warn "Use '$SCRIPT_NAME stop' to stop recording"
    fi
  fi
  
  # Nothing is deleted here: the session directory holds recorded audio, and
  # read-only commands no longer create one.
  release_lock

  exit $exit_code
}

# Set up traps: one canonical handler for normal exit and for interrupts.
# cleanup_on_exit disarms these as its first action to avoid re-entry.
trap 'cleanup_on_exit' INT TERM EXIT

# ============================================================================
# STATE MANAGEMENT
# One session at a time, in $STATE_DIR/session with state files:
#   state, ffmpeg.pid, segment_count, current_file, main_file, segments/
# Not /tmp: a reboot must not lose a paused or interrupted recording (/tmp is
# wiped at boot), and nothing in the session directory is ever auto-deleted.
# ============================================================================

# init_session: point the session file paths at $STATE_DIR/session. Creates
# nothing, so read-only commands leave no state behind.
init_session() {
  SESSION_DIR="$STATE_DIR"/session
  PID_FILE="$SESSION_DIR"/ffmpeg.pid
  STATE_FILE="$SESSION_DIR"/state
  SEGMENT_COUNT_FILE="$SESSION_DIR"/segment_count
  SEGMENTS_DIR="$SESSION_DIR"/segments
  BEEP_PID_FILE="$SESSION_DIR"/beep.pid
  TRANSCRIBE_FILE="$SESSION_DIR"/transcribe
  NO_MP3_FILE="$SESSION_DIR"/no_mp3
}

# preserve_session: move the session directory to $STATE_DIR/recovered_* so a
# new recording can start while its audio stays available for manual recovery
preserve_session() {
  local -- dest="$STATE_DIR"/recovered_"$(get_timestamp)"_$$
  stop_beep_process
  if ! mv -T -- "$SESSION_DIR" "$dest"; then
    error "Could not move ${SESSION_DIR@Q} aside; it is left in place"
    return 1
  fi
  error "Segments preserved in: $dest/segments"
}

# create_session: create an empty session directory (start only, after the
# caller has checked that no session exists). A leftover directory with no
# state file is an interrupted start: it is moved aside, never deleted.
create_session() {
  if [[ -d "$SESSION_DIR" ]]; then
    warn 'Found an incomplete session directory; moving it aside'
    preserve_session || return 1
  fi
  mkdir -p -- "$SEGMENTS_DIR" || { error "Cannot create ${SEGMENTS_DIR@Q}"; return 1; }
}

# ============================================================================
# UTILITY FUNCTIONS
# Disk space checks, timestamp generation, file listing, process validation
# ============================================================================
check_disk_space() {
  local -- path=$1
  local -i required_mb="${2:-$MIN_DISK_SPACE_MB}"  # Use configured minimum
  
  local -i available_mb=$(df -BM "$path" | awk 'NR==2 {print $4}' | sed 's/M//')
  
  if ((available_mb < required_mb)); then
    error "Insufficient disk space: ${available_mb}MB available, ${required_mb}MB required"
    return 1
  fi
  
  return 0
}

# Function to get timestamp for filename
get_timestamp() { date +"%Y%m%d_%H%M%S"; }

# list_recordings: Display WAV files or all files in recordings directory
list_recordings() {
  local -i show_all=${1:-0}
  
  if ((show_all)); then
    printf '%s\n' "All files in $RECORDING_DIR:"
  else
    printf '%s\n' "Available recordings in $RECORDING_DIR:"
  fi
  printf '%s\n' '----------------------------------------'
  
  local -i count=1
  local -i found=0
  local -- file basename size date ext
  
  if ((show_all)); then
    # Show all files
    for file in "$RECORDING_DIR"/*; do
      if [[ -f "$file" ]]; then
        found=1
        basename=$(basename "$file")
        size=$(du -h "$file" | cut -f1)
        date=$(stat -c %y "$file" | cut -d' ' -f1,2 | cut -d'.' -f1)
        ext="${basename##*.}"
        printf "%2d. %-40s [%s] %-8s %s\n" "$count" "$basename" "$size" "[$ext]" "$date"
        count+=1
      fi
    done
  else
    # Show only WAV files
    if compgen -G "$RECORDING_DIR/*.wav" &>/dev/null; then
      found=1
      for file in "$RECORDING_DIR"/*.wav; do
        basename=$(basename "$file")
        size=$(du -h "$file" | cut -f1)
        date=$(stat -c %y "$file" | cut -d' ' -f1,2 | cut -d'.' -f1)
        printf "%2d. %-40s [%s] %s\n" "$count" "$basename" "$size" "$date"
        count+=1
      done
    fi
  fi
  
  if ((found == 0)); then
    if ((show_all)); then
      printf '%s\n' 'No files found.'
    else
      printf '%s\n' 'No recordings found.'
    fi
  fi
  echo
}

# validate_ffmpeg_process: Check if PID is a running ffmpeg process
validate_ffmpeg_process() {
  local -- pid=$1
  
  # Check if process exists
  if ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  
  # Check if it's actually ffmpeg
  local -- cmd=$(ps -p "$pid" -o comm= 2>/dev/null || echo '')
  if [[ "$cmd" != ffmpeg ]]; then
    return 1
  fi
  
  return 0
}

# session_exists: a recording session is in progress (recording or paused).
# The state file decides this: a paused session has no ffmpeg process.
session_exists() { [[ -f "$STATE_FILE" ]]; }

# recorder_alive: the session's ffmpeg is running
recorder_alive() {
  local -- pid
  pid=$(cat -- "$PID_FILE" 2>/dev/null || echo '')
  [[ -n "$pid" ]] && validate_ffmpeg_process "$pid"
}

# start_capture: record from the default source into $1 with a background
# ffmpeg. The state is set to 'recording' first, so a start interrupted at
# any point is still a session that status and stop can see. Returns 1,
# leaving no PID file, if ffmpeg exits at startup (e.g. no audio server);
# the caller then restores or discards the session.
start_capture() {
  local -- out_file=$1
  local -- log_file="$SESSION_DIR"/ffmpeg.log
  check_log_before_write "$log_file"
  # Callers run this under 'if !', which disables set -e in here, so every
  # write is checked explicitly.
  echo 'recording' > "$STATE_FILE" || { error "Cannot write ${STATE_FILE@Q}"; return 1; }
  # file: makes ffmpeg read the operand as a path (it accepts no --)
  ffmpeg -f pulse -i default -acodec "$AUDIO_FORMAT" -ar "$SAMPLE_RATE" -ac "$CHANNELS" file:"$out_file" \
         </dev/null >/dev/null 2>>"$log_file" &
  local -- pid=$!
  if ! echo "$pid" > "$PID_FILE"; then
    # Without a PID file nothing could stop this recorder later
    kill -TERM "$pid" 2>/dev/null || true
    error "Cannot write ${PID_FILE@Q}"
    return 1
  fi

  # Small delay allows ffmpeg to initialize or fail fast
  sleep 0.5
  if ! validate_ffmpeg_process "$pid"; then
    error "Failed to start recording! Check $log_file for details"
    rm -f -- "$PID_FILE"
    return 1
  fi

  # Informational only (status shows its size)
  echo "$out_file" > "$SESSION_DIR"/current_file || warn "Cannot write ${SESSION_DIR@Q}/current_file"
}

# stop_capture: end the running ffmpeg with SIGTERM so it finalises the WAV
# header, forcing SIGKILL after 10 s. A no-op when no recorder is running.
stop_capture() {
  local -- pid
  pid=$(cat -- "$PID_FILE" 2>/dev/null || echo '')
  if [[ -n "$pid" ]] && validate_ffmpeg_process "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    local -i wait_count=0
    while kill -0 "$pid" 2>/dev/null && ((wait_count < 20)); do
      sleep 0.5
      wait_count+=1
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "Process didn't stop cleanly, forcing..."
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f -- "$PID_FILE"
}

# get_last_recording: Find the most recently modified WAV file
# A plain loop, not 'find | sort | head -n1': under pipefail that pipeline died
# with SIGPIPE (exit 141) once the listing outgrew one pipe write (~100 WAVs).
# -nt compares mtimes to the nanosecond and handles any filename.
get_last_recording() {
  local -- file last_file=''
  for file in "$RECORDING_DIR"/*.wav; do
    [[ -f "$file" ]] || continue
    [[ -n "$last_file" && ! "$file" -nt "$last_file" ]] || last_file=$file
  done
  echo "$last_file"
}

# ============================================================================
# LOG MANAGEMENT
# Rotate and cleanup ffmpeg/merge logs to prevent unbounded growth
# ============================================================================
rotate_log() {
  local -- log_file=$1
  local -i max_size_bytes=$((LOG_MAX_SIZE_MB * 1024 * 1024))
  
  # Check if log file exists and size
  if [[ ! -f "$log_file" ]]; then
    return 0
  fi
  
  local -i file_size=$(stat -c%s "$log_file" 2>/dev/null || echo 0)
  
  if ((file_size >= max_size_bytes)); then
    debug "Rotating log file: $log_file (size: $file_size bytes)"
    
    # Rotate existing numbered logs
    local -i i
    for ((i=LOG_MAX_FILES-1; i>=1; i-=1)); do
      if [[ -f "$log_file.$i.gz" ]]; then
        if ((i >= LOG_MAX_FILES-1)); then
          rm -f "$log_file.$i.gz"
        else
          mv "$log_file.$i.gz" "$log_file.$((i+1)).gz"
        fi
      fi
    done
    
    # Compress and rotate current log
    if command -v gzip &>/dev/null; then
      gzip -c "$log_file" > "$log_file.1.gz" && : > "$log_file"
    else
      mv "$log_file" "$log_file.1" && : > "$log_file"
    fi
  fi
}

# clean_old_logs: Remove old log files (STATE_DIR/logs, >30 days). Session
# directories are never reaped: they may hold audio that is not yet merged.
clean_old_logs() {
  # Skip if STATE_DIR doesn't exist
  [[ -d "$STATE_DIR" ]] || return 0

  local -- log_dir="$STATE_DIR"/logs

  if [[ -d "$log_dir" ]]; then
    # Find and remove log files older than 30 days
    find "$log_dir" -name "*.log*" -type f -mtime +30 -delete 2>/dev/null || true
  fi
}

# check_log_before_write: Check and rotate log before writing
check_log_before_write() {
  local -- log_file=$1
  
  # Create log directory if needed
  local -- log_dir=${log_file%/*}
  [[ -d "$log_dir" ]] || mkdir -p "$log_dir"
  
  # Rotate if needed
  rotate_log "$log_file"
}

# ============================================================================
# BEEP NOTIFICATIONS
# Periodic audio reminders during active recording (via ffplay)
# ============================================================================
beep_loop() {
  # Check if beep is enabled
  if ((BEEP_ENABLED == 0 || NO_BEEP == 1)); then
    return 0
  fi
  
  # Search for beep file in multiple locations
  local -a beep_locations=(
    "$BEEP_FILE"  # User configured location
    "$STATE_DIR"/beep.mp3  # User's state directory
    /usr/local/share/vrecord/beep.mp3  # System installation
    /usr/share/vrecord/beep.mp3  # Alternative system location
    "${SCRIPT_PATH%/*}"/beep.mp3  # Same directory as script
  )

  local -i found=0
  local -- location
  for location in "${beep_locations[@]}"; do
    if [[ -f "$location" ]]; then
      BEEP_FILE="$location"
      found=1
      debug "Using beep file ${BEEP_FILE@Q}"
      break
    fi
  done

  if ((found == 0)); then
    debug 'Beep file not found in any standard location'
    return 0
  fi
  
  # Check if ffplay is available
  if ! command -v ffplay &>/dev/null; then
    debug 'ffplay not found, beep notifications disabled'
    return 0
  fi
  
  # Main beep loop
  while :; do
    # Check if we should continue (recording state)
    if [[ -f "$STATE_FILE" ]]; then
      local -- state=$(cat "$STATE_FILE" 2>/dev/null || echo 'unknown')
      if [[ "$state" != recording ]]; then
        # Not recording, wait and check again
        sleep 5
        continue
      fi
    else
      # No state file, exit
      break
    fi
    
    # Play the beep
    ffplay -nodisp -autoexit -loglevel quiet "$BEEP_FILE" &>/dev/null || true
    
    # Sleep for the interval
    sleep "$BEEP_INTERVAL"
  done
}

# start_beep_process: Start the beep notification background process
start_beep_process() {
  # Check if beep is enabled
  if ((BEEP_ENABLED == 0 || NO_BEEP == 1)); then
    return 0
  fi
  
  # Check if already running
  if [[ -f "$BEEP_PID_FILE" ]]; then
    local -- pid=$(cat "$BEEP_PID_FILE" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      debug "Beep process already running: $pid"
      return 0
    fi
  fi
  
  # Start beep loop in background
  beep_loop &
  local -- beep_pid=$!
  echo "$beep_pid" > "$BEEP_PID_FILE"
  debug "Started beep process: $beep_pid"
}

# stop_beep_process: Stop the beep notification background process
stop_beep_process() {
  if [[ -f "$BEEP_PID_FILE" ]]; then
    local -- pid=$(cat "$BEEP_PID_FILE" 2>/dev/null)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      debug "Stopped beep process: $pid"
    fi
    rm -f "$BEEP_PID_FILE"
  fi
}

# ============================================================================
# RECORDING CONTROL
# Core operations: start, pause, resume, stop, merge, convert
# ============================================================================

# start_recording: Begin new recording or continue an existing WAV file
# New recordings: create ${prefix}_TIMESTAMP.wav in RECORDING_DIR
# Resume/continue: record new segments to SESSION_DIR/segments/, merge on stop
# Args: $1=prefix, $2=resume_file, $3=continue_last_flag
start_recording() {
  local -- filename_prefix=${1:-$DEFAULT_PREFIX}
  local -- resume_file=${2:-}
  local -i continue_last=${3:-0}
  
  # Validate filename prefix if provided and not using continue/resume
  if [[ -n "$filename_prefix" ]] && [[ "$filename_prefix" != "$DEFAULT_PREFIX" ]] && \
     [[ -z "$resume_file" ]] && ((continue_last == 0)); then
    if ! validate_safe_filename "$filename_prefix" 0; then
      return 1
    fi
  fi

  # Validate resume file if provided
  if [[ -n "$resume_file" ]]; then
    if ! validate_safe_filename "$resume_file" 1; then
      return 1
    fi
  fi

  check_dependencies
  acquire_lock || return 1
  init_session
  
  local -- output_file=''

  # Check disk space
  check_disk_space "$RECORDING_DIR" 100 || return 1
  check_disk_space "$STATE_DIR" 100 || return 1  # resume segments live here

  # Check if directory is writable
  if ! touch "$RECORDING_DIR/.test" 2>/dev/null; then
    error "Recording directory is not writable ${RECORDING_DIR@Q}"
    return 1
  fi
  rm -f "$RECORDING_DIR"/.test

  # Handle continue-last flag
  if ((continue_last)); then
    resume_file=$(get_last_recording)
    if [[ -z "$resume_file" ]]; then
      error 'No recordings found to continue!'
      return 1
    fi
    info "Continuing last recording '$(basename "$resume_file")'"
  fi
  
  # Check if we're resuming an existing file
  if [[ -n "$resume_file" ]]; then
    if [[ -f "$resume_file" ]]; then
      # Validate full path is within recording directory
      if ! validate_recording_path "$resume_file"; then
        return 1
      fi
      # File exists, good to go
      true
    elif [[ -f "$RECORDING_DIR/$resume_file" ]]; then
      resume_file="$RECORDING_DIR/$resume_file"
      # Validate constructed path
      if ! validate_recording_path "$resume_file"; then
        return 1
      fi
    else
      error "File ${resume_file@Q} not found!" \
            "Use 'list' command to see available recordings."
      return 1
    fi
  fi

  if recorder_alive; then
    error 'Recording is already in progress!'
    return 1
  fi
  # Never replace an existing session: a paused one has no recorder process,
  # and an interrupted one (ffmpeg crashed) still holds unmerged audio.
  if session_exists; then
    if [[ $(cat -- "$STATE_FILE" 2>/dev/null) == paused ]]; then
      error 'A recording is paused.' \
            "Use '$SCRIPT_NAME resume' to continue it or '$SCRIPT_NAME stop' to finish it."
    else
      error 'The previous recording was interrupted (its recorder is no longer running).' \
            "Run '$SCRIPT_NAME stop' to save it, then start again."
    fi
    return 1
  fi
  create_session || return 1

  local -- capture_file=''
  if [[ -n "$resume_file" ]]; then
    # Resuming existing recording
    output_file="$resume_file"
    info "Resuming recording '$(basename "$output_file")'" \
         "Original file size: $(du -h "$output_file" | cut -f1)"

    # Store the main file path for later merging
    echo "$output_file" > "$SESSION_DIR"/main_file

    # Get or initialize segment count
    local -i segment_count=$(cat "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')
    segment_count+=1
    capture_file="$SEGMENTS_DIR"/segment_"$segment_count".wav
    echo "$segment_count" > "$SEGMENT_COUNT_FILE"

    info "Recording new segment ${capture_file@Q}"
  else
    # New recording
    local -- timestamp=$(get_timestamp)
    # Clean up prefix: remove trailing underscore to avoid double underscores
    filename_prefix="${filename_prefix%_}"
    output_file="$RECORDING_DIR/${filename_prefix}_$timestamp.wav"
    info 'Starting new recording...' \
         "Output file ${output_file@Q}"

    echo '0' > "$SEGMENT_COUNT_FILE"
    echo "$output_file" > "$SESSION_DIR"/main_file
    capture_file=$output_file
  fi

  # Save the transcribe and no-MP3 flags: stop runs as a separate invocation
  if ((TRANSCRIBE == 1)); then
    echo '1' > "$TRANSCRIBE_FILE"
  fi
  if ((NO_MP3 == 1)); then
    echo '1' > "$NO_MP3_FILE"
  fi

  # The session was created by this run and holds no audio yet: discard it
  if ! start_capture "$capture_file"; then
    cleanup_files
    return 1
  fi

  info "Recording started. PID: $(cat -- "$PID_FILE")" \
       "Use '$SCRIPT_NAME stop' to stop recording"
  
  # Start beep notifications
  start_beep_process
       
  release_lock
}

# pause_recording: End the current segment; resume_recording() starts a new
# one, and stop merges them. ffmpeg is not SIGSTOPped: a stopped recorder
# leaves the audio server buffering, and up to ~24 s of "paused" audio was
# handed over on resume and recorded.
pause_recording() {
  acquire_lock || return 1
  init_session

  session_exists || { error 'No active recording found!'; release_lock; return 1; }

  local -- state=$(cat "$STATE_FILE" 2>/dev/null || echo 'unknown')

  if [[ "$state" == paused ]]; then
    error 'Recording is already paused!'
    release_lock
    return 1
  fi

  if recorder_alive; then
    info 'Pausing recording...'
    # Stop beep notifications while paused
    stop_beep_process
    stop_capture
    echo 'paused' > "$STATE_FILE"

    info "Recording paused. Use 'resume' to continue."
  else
    # The recorder is gone; finalize and recover any segments rather than
    # deleting them (the old code ran cleanup_files here, losing the audio).
    finalize_orphaned_session || return 1
    return 0
  fi

  release_lock
}

# resume_recording: Record a new segment after a pause (merged on stop)
resume_recording() {
  acquire_lock || return 1
  init_session

  if ! session_exists; then
    error 'No active recording found!'
    release_lock
    return 1
  fi

  local -- state=$(cat "$STATE_FILE" 2>/dev/null || echo 'unknown')

  if [[ "$state" == recording ]]; then
    error 'Recording is already active!'
    release_lock
    return 1
  fi

  # The segment count advances only once ffmpeg is confirmed running, so a
  # failed resume leaves the session paused and intact.
  local -i segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')
  segment_count+=1
  local -- segment_file="$SEGMENTS_DIR"/segment_"$segment_count".wav

  info 'Resuming recording...'
  if ! start_capture "$segment_file"; then
    rm -f -- "$segment_file"
    echo 'paused' > "$STATE_FILE"
    release_lock
    return 1
  fi
  echo "$segment_count" > "$SEGMENT_COUNT_FILE"

  # Restart beep notifications
  start_beep_process

  info 'Recording resumed.'
  release_lock
}

# merge_segments: Combine original file with recorded segments using ffmpeg
# Uses ffmpeg concat demuxer with a filelist.txt containing:
#   file '/path/to/original.wav'
#   file '/path/to/segment_1.wav'
#   ...
# Segments are removed after successful merge; preserved on failure for recovery
merge_segments() {
  local -- main_file=$1
  local -i segment_count=$(cat "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')
  
  ((segment_count)) || return 0  # No segments to merge
  # With no main file the segments cannot be merged: fail, so the caller
  # keeps them (preserve_session) instead of cleaning the session up
  [[ -n "$main_file" ]] || { error 'This session has no main recording to merge into'; return 1; }

  info 'Merging segments with original recording...'

  # Create concat demuxer input file for ffmpeg
  # Format: each line contains "file '/path/to/file.wav'"
  local -- filelist="$SESSION_DIR"/filelist.txt
  echo "file '$main_file'" > "$filelist"

  # Add all segments to the list
  local -i i
  local -- segment_file
  for ((i=1; i<=segment_count; i+=1)); do
    segment_file="$SEGMENTS_DIR"/segment_"$i".wav
    if [[ -f "$segment_file" ]]; then
      echo "file ${segment_file@Q}" >> "$filelist"
    fi
  done

  # Merge into a temp file beside the main file, so replacing it is an atomic
  # same-filesystem rename, never a copy that an interruption could truncate.
  # Dot-prefixed and not *.wav, so list/play/start -c ignore it; -f wav because
  # the name has no .wav extension. mktemp creates it 0600, so the original
  # recording's mode is copied onto it before the rename.
  local -- temp_merged
  temp_merged=$(mktemp -- "${main_file%/*}"/.vrecord-merge.XXXXXX) || {
    error "Cannot create a merge file beside ${main_file@Q}"
    return 1
  }
  MERGE_TEMP=$temp_merged

  local -- log_file="$SESSION_DIR"/merge.log
  check_log_before_write "$log_file"
  # file: makes ffmpeg read the operand as a path (it accepts no --)
  if ffmpeg -y -f concat -safe 0 -i "$filelist" -c copy -f wav file:"$temp_merged" \
            </dev/null >/dev/null 2>>"$log_file"; then
    chmod --reference="$main_file" -- "$temp_merged" \
      || warn "Could not copy the permissions of ${main_file@Q}"
    # Replace original with merged version
    mv -f -- "$temp_merged" "$main_file" || {
      MERGE_TEMP=''  # the merged output is the only complete copy: keep it
      error "Failed to replace ${main_file@Q} with merged output (kept ${temp_merged@Q})"
      return 1
    }
    MERGE_TEMP=''
    info "Successfully merged segments into ${main_file@Q}"

    # Clean up segment files
    rm -f "$SEGMENTS_DIR"/segment_*.wav
    rm -f "$filelist"
  else
    rm -f -- "$temp_merged"
    MERGE_TEMP=''
    error 'Error: Failed to merge segments!' \
          "Original file preserved: $main_file"
    return 1
  fi
}

# finalize_orphaned_session: called when the recorder process is gone
# (crash / OOM / external kill). Merge any resume segments into the original
# BEFORE cleanup so freshly recorded audio is not lost, then clear session
# state and release the lock. Returns 1 on merge failure, after moving the
# session (segments + merge.log) aside to $STATE_DIR/recovered_*; 0 otherwise.
finalize_orphaned_session() {
  warn 'Recording process not found (it may have already exited).'
  stop_beep_process

  local -- main_file=''
  main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null || echo '')
  local -i segment_count=0
  segment_count=$(cat "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  if ((segment_count > 0)); then
    merge_segments "$main_file" || {
      error 'Merge failed - segments and merge.log kept for recovery.'
      preserve_session || true
      release_lock
      return 1
    }
  fi

  cleanup_files
  release_lock
  return 0
}

# stop_recording: End recording session and finalize output files
# Ends the recorder if one is running (a paused session has none), then:
# merge segments (if any), convert to MP3 (unless --no-mp3), transcribe (if -t)
stop_recording() {
  acquire_lock || return 1
  init_session

  if ! session_exists; then
    error 'No active recording found!'
    release_lock
    return 1
  fi

  local -- state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')
  local -- main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null)
  local -i segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  if [[ "$state" == paused ]] || recorder_alive; then
    info 'Stopping recording...'

    # Stop beep notifications
    stop_beep_process
    stop_capture

    info 'Recording stopped.'

    # If we have segments, merge them. Guard with `|| ` so a merge failure
    # cannot trip set -e and skip the lock-release epilogue below. On failure
    # the session is moved aside, so a new recording can start meanwhile.
    if ((segment_count > 0)); then
      merge_segments "$main_file" || {
        error 'Merge failed - segments and merge.log kept for recovery.'
        preserve_session || true
        release_lock
        return 1
      }
    fi

    if [[ -n "$main_file" && -f "$main_file" ]]; then
      info "Recording saved to ${main_file@Q}"

      # Show file info
      if command -v mediainfo &>/dev/null; then
        info 'File info:'
        mediainfo "$main_file" 2>/dev/null | grep -E "(Duration|File size)" >&2 || true
      else
        info "File size: $(du -h "$main_file" | cut -f1)"
      fi
      
      # Convert to MP3 unless --no-mp3 was given to start or to stop. Guard
      # the call so a conversion failure cannot skip the cleanup/lock-release
      # epilogue. Transcription runs on the MP3, so -n also skips it.
      [[ ! -f "$NO_MP3_FILE" ]] || NO_MP3=1
      if ((NO_MP3 == 0)); then
        convert_to_mp3 "$main_file" || warn 'MP3 conversion failed; WAV is intact.'
      elif [[ -f "$TRANSCRIBE_FILE" ]] || ((TRANSCRIBE == 1)); then
        warn 'Transcription skipped: it runs on the MP3, and --no-mp3 is in effect.'
      fi
    fi
  else
    # ffmpeg is already gone (crash / OOM / external kill); finalize and
    # recover any segments instead of stopping a live process.
    finalize_orphaned_session || return 1
    return 0
  fi

  cleanup_files
  release_lock

  # Report the saved recording on stdout (all messages go to stderr), so
  # callers such as vrecord-loop never have to guess which file was written.
  [[ ! -f "$main_file" ]] || printf '%s\n' "$main_file"
}

# convert_to_mp3: Convert WAV recording to MP3 format
convert_to_mp3() {
  local -- wav_file=$1
  local -- mp3_file="${wav_file%.wav}".mp3
  
  if ! command -v ffmpeg &>/dev/null; then
    warn "ffmpeg not found, skipping MP3 conversion"
    return 1
  fi
  
  info "Converting to MP3: $(basename -- "$mp3_file")"
  
  local -- log_file="$SESSION_DIR"/mp3_convert.log
  check_log_before_write "$log_file"
  if ffmpeg -y -i "$wav_file" -codec:a libmp3lame -b:a "$MP3_BITRATE" "$mp3_file" \
            </dev/null >/dev/null 2>>"$log_file"; then
    # Wait a moment for file system to sync
    sync
    success "MP3 created: $mp3_file"
    info "MP3 size: $(du -h "$mp3_file" | cut -f1)"
    
    # Run transcription if requested and transcribe command is available
    if [[ -f "$TRANSCRIBE_FILE" ]] || ((TRANSCRIBE == 1)); then
      if command -v transcribe &>/dev/null; then
        info "Running transcription on: $(basename "$mp3_file")"
        # stdout is reserved for stop's result line (the saved WAV path)
        if transcribe -- "$mp3_file" >&2; then
          success 'Transcription completed'
        else
          warn 'Transcription failed'
        fi
      else
        warn 'Transcribe command not found, skipping transcription'
      fi
    fi
  else
    error 'Failed to convert to MP3' \
          "Check $SESSION_DIR/mp3_convert.log for details"
    return 1
  fi
}

# show_status: Display current recording status and statistics
show_status() {
  init_session

  if session_exists; then
    local -- state=$(cat "$STATE_FILE" 2>/dev/null || echo 'unknown')
    local -- main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null)
    local -- current_file=$(cat -- "$SESSION_DIR"/current_file 2>/dev/null)
    local -i segment_count=$(cat "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

    if [[ "$state" == paused ]] || recorder_alive; then
      info "Recording Status: $state"
      [[ "$state" == paused ]] || info "PID: $(cat -- "$PID_FILE")"
      info "Main file: $main_file"
      if ((segment_count > 0)); then
        info "Resume segments: $segment_count" \
             "Original file size: $(du -h "$main_file" 2>/dev/null | cut -f1 || echo "Unknown")"
        if [[ -f "$current_file" ]]; then
          info "Current segment size: $(du -h "$current_file" 2>/dev/null | cut -f1 || echo "Unknown")"
        fi
      else
        if [[ -f "$current_file" ]]; then
          info "Current file size: $(du -h "$current_file" 2>/dev/null | cut -f1 || echo "Unknown")"
        fi
      fi
      
      # Check for errors in log
      if [[ -f "$SESSION_DIR"/ffmpeg.log ]] && [[ -s "$SESSION_DIR"/ffmpeg.log ]]; then
        local -- last_error=$(tail -n 5 -- "$SESSION_DIR"/ffmpeg.log 2>/dev/null | grep -i error | tail -n 1)
        [[ -z "$last_error" ]] || warn "Recent error: $last_error"
      fi
    else
      # The recorder died (crash, OOM kill, reboot). status is read-only:
      # leave everything in place so 'stop' can merge what was recorded.
      error 'Recording interrupted: the recorder process is no longer running.' \
            "Main file: $main_file" \
            "Run '$SCRIPT_NAME stop' to save what was recorded."
    fi
  else
    error 'No active recording'
  fi
}

# cleanup_files: End the session by removing its directory. Called only once
# its audio is safe: merged into the main file, or never recorded.
cleanup_files() {
  # Stop beep process if running
  stop_beep_process

  if [[ -n "$SESSION_DIR" && -d "$SESSION_DIR" ]]; then
    rm -rf -- "$SESSION_DIR" || warn "Could not remove ${SESSION_DIR@Q}"
  fi
}

# show_help: Display usage information
show_help() {
  cat <<HELP
vrecord - Voice Recorder with Resume Capability

Usage: $SCRIPT_NAME [options] <command> [args]

Commands:
  start [PREFIX]    Start new recording (default prefix: voice_recording)
  start -c          Continue the most recent recording
  start -r FILE     Resume a specific WAV file
  pause             Pause recording (ends the current segment)
  resume            Resume recording into a new segment (merged on stop)
  stop              Stop recording, create MP3; prints the saved WAV path on stdout
  status            Show recording state and file info
  list [--all]      List WAV files (or all files with --all)
  play [FILE]       Play a recording (most recent if FILE omitted; .wav optional)
  help              Show this help

Start Options:
  -c, --continue-last   Append to the most recent WAV file
  -r, --resume FILE     Append to a specific WAV file
  -t, --transcribe      Transcribe after MP3 conversion

Stop Options:
  -t, --transcribe      Transcribe the MP3 file

Global Options:
  -n, --no-mp3     Skip MP3 conversion
  -b, --no-beep    Disable periodic beep reminders
  -v, --verbose    Increase output verbosity
  -q, --quiet      Suppress non-error output
  -h, --help       Show this help
  -V, --version    Show version

Examples:
  # Basic workflow
  $SCRIPT_NAME start meeting       # → meeting_20250120_143052.wav
  $SCRIPT_NAME pause               # Pause recording
  $SCRIPT_NAME resume              # Resume recording
  $SCRIPT_NAME stop                # → meeting_20250120_143052.mp3

  # Continue previous recording
  $SCRIPT_NAME start -c            # Append to most recent WAV

  # Play a recording
  $SCRIPT_NAME play                # Play the most recent recording
  $SCRIPT_NAME play meeting_20250120_143052   # Specific file (.wav optional)

  # Record with transcription
  $SCRIPT_NAME start -t notes      # Start with transcribe flag
