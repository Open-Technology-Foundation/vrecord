#!/usr/bin/env bash
# vrecord - Voice Recorder with Resume Capability
# Copyright (C) 2024-2025 Open Technology Foundation
# License: GPL-3.0-or-later <https://gnu.org/licenses/gpl.html>
#
# Command-line voice recorder for Linux with:
#   - Pause/resume: pause ends the current segment, resume records a new one
#   - Continue/append to existing WAV recordings
#   - Automatic MP3 conversion (libmp3lame)
#   - Optional transcription integration
#   - Playback of recordings via xdg-open
#
# Dependencies: ffmpeg (PulseAudio), pactl | Optional: mediainfo, transcribe, xdg-open
#
set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

# Lock PATH to standard locations so the external tools this script runs
# (ffmpeg, pactl, ffplay, mediainfo, transcribe) cannot be hijacked via a
# rogue binary earlier in an inherited PATH.
declare -rx PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Script metadata
declare -r VERSION=1.3.1
#shellcheck disable=SC2155 # realpath of the running script cannot fail
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# ============================================================================
# LOGGING AND OUTPUT
# Provides colored, level-based messaging (info/warn/error/debug/success)
# ============================================================================
declare -i VERBOSE=1  # 0 = -q (errors only), 1 = default, 2+ = -v (adds debug)
# Standard colours
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' GREEN='' YELLOW='' CYAN='' NC=''
fi
# Core message function using FUNCNAME for context
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    success) prefix+=" ${GREEN}✓${NC}" ;;
    warn)    prefix+=" ${YELLOW}▲${NC}" ;;
    info)    prefix+=" ${CYAN}◉${NC}" ;;
    error)   prefix+=" ${RED}✗${NC}" ;;
    debug)   prefix+=" ${YELLOW}⦿${NC}" ;;
    *)       ;;
  esac
  for msg in "$@"; do printf '%s %s\n' "$prefix" "$msg"; done
}
# Conditional output based on verbosity
success() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
warn() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
info() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
debug() { ((VERBOSE > 1)) || return 0; >&2 _msg "$@"; }
# Unconditional output
error() { >&2 _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# ============================================================================
# SECURITY AND VALIDATION
# Input sanitization to prevent path traversal, injection, and shell exploits
# ============================================================================

# validate_safe_filename: Reject filenames with dangerous characters or patterns
# Rules: alphanumeric, dots, underscores, hyphens only; no leading dash; no ..;
# a bare name (a recording prefix) may not start with a dot either
# Args: $1=filename, $2=allow_path (0=filename only, 1=allow /)
validate_safe_filename() {
  local -- filename=$1
  local -i allow_path=${2:-0}  # Allow paths with slashes

  # Check for empty filename
  if [[ -z "$filename" ]]; then
    error 'Filename cannot be empty'
    return 1
  fi

  # Check length (255 for filename, longer for full paths)
  local -i max_length=255
  ((allow_path==0)) || max_length=4096
  if ((${#filename} > max_length)); then
    error "Filename too long (max $max_length characters)"
    return 1
  fi

  # Check for directory traversal
  if [[ "$filename" =~ \.\. ]]; then
    error 'Directory traversal not allowed in filename'
    return 1
  fi

  # Validate characters based on whether paths are allowed. This whitelist
  # also excludes shell metacharacters and NUL (which Bash strings cannot hold).
  if ((allow_path)); then
    # Allow alphanumeric, dots, underscores, hyphens, and forward slashes
    if [[ "$filename" =~ [^a-zA-Z0-9._/-] ]]; then
      error 'Unsafe characters in filename. Only alphanumeric, dots, underscores, hyphens and slashes allowed.'
      return 1
    fi
  else
    # Disallow slashes for pure filenames
    if [[ "$filename" =~ [^a-zA-Z0-9._-] ]]; then
      error 'Unsafe characters in filename. Only alphanumeric, dots, underscores and hyphens allowed.'
      return 1
    fi
    # A hidden recording: list, start -c and play (no name) never see it.
    # Paths keep a leading dot ('./take.wav').
    if [[ "$filename" == .* ]]; then
      error 'Filename prefix cannot start with a dot'
      return 1
    fi
  fi

  # Check for leading dash (could be interpreted as option)
  if [[ "$filename" =~ ^- ]]; then
    error 'Filename cannot start with dash'
    return 1
  fi

  return 0
}

# validate_recording_path: Ensure file path is within RECORDING_DIR
# Prevents directory traversal attacks by comparing canonical paths
validate_recording_path() {
  local -- filepath=$1

  # Get absolute paths for comparison
  local -- abs_path abs_recording_dir
  abs_path=$(realpath -- "$filepath" 2>/dev/null) || abs_path="$filepath"
  abs_recording_dir=$(realpath -- "$RECORDING_DIR" 2>/dev/null) || abs_recording_dir="$RECORDING_DIR"

  # Must be under RECORDING_DIR
  if [[ "$abs_path" != "$abs_recording_dir"/* ]] && [[ "$abs_path" != "$abs_recording_dir" ]]; then
    error "File must be within recording directory ${RECORDING_DIR@Q}"
    return 1
  fi

  return 0
}

# ============================================================================
# CONFIGURATION
# Settings with defaults; overridden by config files, then VRECORD_* env vars
# ============================================================================

# drop_bad_int_env NAME...: unset each named environment value that is not a
# whole number, with a warning, so its default below applies. declare -i
# evaluates what it is given as arithmetic: 'stereo' reads as an unset
# variable, which ends vrecord under set -u, '08' as bad octal, and
# 'HOME[$(cmd)]' runs cmd.
drop_bad_int_env() {
  local -- name
  for name in "$@"; do
    [[ -n ${!name:-} && ! ${!name} =~ ^(0|[1-9][0-9]*)$ ]] || continue
    warn "Ignoring $name=${!name@Q} from the environment: not a whole number"
    unset -v "$name"
  done
}
drop_bad_int_env SAMPLE_RATE CHANNELS MIN_DISK_SPACE_MB LOG_MAX_SIZE_MB LOG_MAX_FILES \
                 BEEP_ENABLED BEEP_INTERVAL

# Recording parameters - directory paths and audio settings
declare -- RECORDING_DIR=${RECORDING_DIR:-$HOME/Recordings}  # Where WAV/MP3 files are saved
declare -- STATE_DIR=${STATE_DIR:-$HOME/.vrecord}            # Persistent state (config, beep.mp3)
declare -- DEFAULT_PREFIX=${DEFAULT_PREFIX:-voice_recording} # Filename prefix when none specified
declare -- MP3_BITRATE=${MP3_BITRATE:-192k}                  # libmp3lame bitrate
declare -- AUDIO_FORMAT=${AUDIO_FORMAT:-pcm_s16le}           # WAV codec (16-bit PCM)
declare -i SAMPLE_RATE=${SAMPLE_RATE:-44100}                 # Audio sample rate (Hz)
declare -i CHANNELS=${CHANNELS:-2}                           # Mono (1) or stereo (2)
declare -i MIN_DISK_SPACE_MB=${MIN_DISK_SPACE_MB:-100}       # Minimum free space to start
declare -i LOG_MAX_SIZE_MB=${LOG_MAX_SIZE_MB:-10}            # Rotate logs when exceeded
declare -i LOG_MAX_FILES=${LOG_MAX_FILES:-5}                 # Keep N rotated log files

# Beep notifications - periodic audio reminder during recording
declare -i BEEP_ENABLED=${BEEP_ENABLED:-1}                   # 1=enabled, 0=disabled
declare -i BEEP_INTERVAL=${BEEP_INTERVAL:-60}                # Seconds between beeps
declare -- BEEP_FILE=${BEEP_FILE:-"$STATE_DIR"/beep.mp3}     # Sound file path

# Runtime state - initialized during execution
declare -- SESSION_DIR=''  # Session dir: $STATE_DIR/session (set by init_session)
declare -- MERGE_TEMP=''   # Merge output being written; cleanup_on_exit removes it
declare -- PID_FILE STATE_FILE SEGMENT_COUNT_FILE SEGMENTS_DIR LOCK_FILE LOG_DIR \
           BEEP_PID_FILE TRANSCRIBE_FILE NO_MP3_FILE FORMAT_FILE

# Command-line flags - set by option parsing
declare -i NO_MP3=0      # --no-mp3: skip MP3 conversion
declare -i NO_BEEP=0     # --no-beep: suppress beep notifications
declare -i TRANSCRIBE=0  # --transcribe: run transcription after MP3

# load_config: Source a config file if it exists and is valid. Checked first,
# for what would otherwise end vrecord itself: a syntax error (bash -n), and,
# in a dry run, an unset name under set -u (SAMPLE_RATE=abc reads 'abc' as a
# variable). The dry run ends with 'exit 0' so it judges the whole file, not
# the status of its last line. The real source runs under '||', so a failing
# command inside the file cannot trip set -e.
load_config() {
  local -- config_file=$1
  [[ -f "$config_file" ]] || return 0
  # shellcheck disable=SC1090 # the config path is chosen at run time
  if ! "$BASH" -n -- "$config_file" 2>/dev/null \
     || ! (source -- "$config_file"; exit 0) &>/dev/null; then
    warn "Invalid config file ${config_file@Q}; ignoring it"
    return 0
  fi
  # shellcheck disable=SC1090 # the config path is chosen at run time
  source -- "$config_file" || :
}

# Configuration precedence (highest to lowest):
#   1. VRECORD_* environment variables
#   2. User config: ~/.vrecord/config
#   3. System config: /etc/vrecord/config
#   4. Built-in defaults (above)
load_config /etc/vrecord/config
load_config "$STATE_DIR"/config

# Environment variable overrides (VRECORD_* prefix)
RECORDING_DIR=${VRECORD_RECORDING_DIR:-$RECORDING_DIR}
STATE_DIR=${VRECORD_STATE_DIR:-$STATE_DIR}
DEFAULT_PREFIX=${VRECORD_DEFAULT_PREFIX:-$DEFAULT_PREFIX}
MP3_BITRATE=${VRECORD_MP3_BITRATE:-$MP3_BITRATE}

# Create directories if they don't exist
mkdir -p -- "$RECORDING_DIR" "$STATE_DIR" \
  || die 1 "Cannot create ${RECORDING_DIR@Q} or ${STATE_DIR@Q}"

# Absolute from here on (-s keeps symlinks as the user named them), so no
# path built from them can begin with a dash: xdg-open, for one, takes no --
RECORDING_DIR=$(realpath -s -- "$RECORDING_DIR") || die 1 "Cannot resolve ${RECORDING_DIR@Q}"
STATE_DIR=$(realpath -s -- "$STATE_DIR") || die 1 "Cannot resolve ${STATE_DIR@Q}"

# Derived paths. Logs live outside the session directory: an error message
# that names a log must not point at a file the session's cleanup removed.
LOCK_FILE="$STATE_DIR"/vrecord.lock
LOG_DIR="$STATE_DIR"/logs

# ============================================================================
# DEPENDENCY CHECKS
# Verify required tools (ffmpeg with PulseAudio, pactl) are available
# ============================================================================
check_dependencies() {
  local -i missing=0
  
  if ! command -v ffmpeg &>/dev/null; then
    error 'ffmpeg is not installed!'
    missing+=1
  else
    # Captured, not piped into 'grep -q': grep would exit at the first match
    # and, under pipefail, ffmpeg's SIGPIPE would fail the check
    local -- devices
    devices=$(ffmpeg -hide_banner -devices 2>&1) || devices=''
    if [[ "$devices" != *pulse* ]]; then
      error 'ffmpeg does not have PulseAudio support!'
      missing+=1
    fi
  fi
  
  if ! command -v pactl &>/dev/null; then
    error 'PulseAudio is not installed!'
    missing+=1
  fi
  
  ((missing == 0)) || die 1 'Missing dependencies. Please install required software.'
}

# ============================================================================
# LOCK FILE MANAGEMENT
# Prevents concurrent vrecord instances via exclusive file locking
# ============================================================================

# acquire_lock: take the exclusive lock (flock on FD 9), waiting up to $1
# seconds (default 5). The lock belongs to the open file description, so
# background children that outlive this run (the recorder, the beep loop)
# are started with 9>&-: otherwise a killed vrecord would leave them holding
# the lock for the whole recording.
acquire_lock() {
  local -i timeout=${1:-5}

  command -v flock &>/dev/null || { error 'flock not found (install util-linux)'; return 1; }
  exec 9>"$LOCK_FILE" || {
    error "Cannot open lock file ${LOCK_FILE@Q}"
    return 1
  }
  # No -n: with it, -w is ignored and flock gives up at once
  if ! flock -w "$timeout" 9; then
    exec 9>&-
    error "Another instance is running (gave up after ${timeout}s)"
    return 1
  fi
  debug 'Lock acquired'
}

# release_lock: drop the lock and close FD 9. The lock file is never unlinked:
# another instance could then lock a fresh inode while this one still held the
# old one. Harmless when FD 9 is not open.
release_lock() {
  flock -u 9 2>/dev/null || true
  exec 9>&-
  debug 'Lock released'
}

# ============================================================================
# CLEANUP AND SIGNAL HANDLING
# Graceful shutdown: release locks, preserve active recordings if running
# ============================================================================
# cleanup_on_exit: release the lock and exit. $1, given by the INT and TERM
# traps, is the exit status (128 + signal number); the EXIT trap passes none
# and keeps the status the script was ending with.
cleanup_on_exit() {
  local -i exit_code=$?
  ((! $#)) || exit_code=$1
  # Disarm traps so the exit below cannot re-enter this handler via the EXIT
  # trap (signal -> cleanup_on_exit -> exit -> EXIT trap -> cleanup_on_exit).
  trap - INT TERM EXIT

  # An interrupted merge: its partial output is useless (the original and the
  # segments are untouched, so 'stop' can simply run again) and its random
  # name would never be reused, so it would sit beside the recordings forever.
  # '|| :': under set -e a failed rm would end the handler with its status,
  # not exit_code
  [[ -z "$MERGE_TEMP" ]] || rm -f -- "$MERGE_TEMP" || :

  # Nothing else is deleted here: the session directory holds recorded audio.
  release_lock

  exit "$exit_code"
}

# One handler for normal exit and for interrupts; it disarms all three first.
trap 'cleanup_on_exit 130' INT
trap 'cleanup_on_exit 143' TERM
trap 'cleanup_on_exit' EXIT

# ============================================================================
# STATE MANAGEMENT
# One session at a time, in $STATE_DIR/session with state files:
#   state, ffmpeg.pid, segment_count, current_file, main_file, segments/
# Not /tmp: a reboot must not lose a paused or interrupted recording (/tmp is
# wiped at boot), and nothing in the session directory is ever auto-deleted.
# ============================================================================

# init_session: point the session file paths at $STATE_DIR/session. Creates
# nothing, so read-only commands leave no state behind.
init_session() {
  SESSION_DIR="$STATE_DIR"/session
  PID_FILE="$SESSION_DIR"/ffmpeg.pid
  STATE_FILE="$SESSION_DIR"/state
  SEGMENT_COUNT_FILE="$SESSION_DIR"/segment_count
  SEGMENTS_DIR="$SESSION_DIR"/segments
  BEEP_PID_FILE="$SESSION_DIR"/beep.pid
  TRANSCRIBE_FILE="$SESSION_DIR"/transcribe
  NO_MP3_FILE="$SESSION_DIR"/no_mp3
  FORMAT_FILE="$SESSION_DIR"/format
}

# session_format: print the session's recording format, "codec rate channels".
# start saves it, so a resume matches the recording whatever the config says
# by then; a session from 1.2.0 has none and uses the configured format.
session_format() {
  local -- format=''
  [[ ! -f "$FORMAT_FILE" ]] || format=$(<"$FORMAT_FILE")
  [[ -n "$format" ]] || format="$AUDIO_FORMAT $SAMPLE_RATE $CHANNELS"
  printf '%s\n' "$format"
}

# write_state: write value $2 to session file $1. The session files are what
# later commands act on, so a write that fails is an error, never ignored.
write_state() {
  { printf '%s\n' "$2" > "$1"; } 2>/dev/null || { error "Cannot write ${1@Q}"; return 1; }
}

# probe_wav: print the format of recording $1 as "codec rate channels"; fail
# unless it is a PCM WAV. New audio is recorded in this format because the
# merge copies streams under the first file's header: audio at another rate
# or channel count was silently reinterpreted (wrong speed and length).
probe_wav() {
  local -- file=$1 out='' key value codec='' rate='' channels='' format=''
  command -v ffprobe &>/dev/null \
    || { error 'ffprobe (part of ffmpeg) is required to continue a recording'; return 1; }
  out=$(ffprobe -v error -select_streams a:0 \
          -show_entries stream=codec_name,sample_rate,channels:format=format_name \
          -of default=noprint_wrappers=1 file:"$file" 2>/dev/null) || out=''
  while IFS='=' read -r key value; do
    case $key in
      codec_name)  codec=$value ;;
      sample_rate) rate=$value ;;
      channels)    channels=$value ;;
      format_name) format=$value ;;
    esac
  done <<<"$out"
  if [[ "$format" != wav || "$codec" != pcm_* || ! "$rate" =~ ^[0-9]+$ || ! "$channels" =~ ^[0-9]+$ ]]; then
    error "Only PCM WAV recordings can be continued: ${file@Q} is not one"
    return 1
  fi
  printf '%s %s %s\n' "$codec" "$rate" "$channels"
}

# preserve_session: move the session directory to $STATE_DIR/recovered_* so a
# new recording can start while its audio stays available for manual recovery
preserve_session() {
  local -- dest
  dest="$STATE_DIR"/recovered_"$(get_timestamp)"_$$
  stop_beep_process
  if ! mv -T -- "$SESSION_DIR" "$dest"; then
    error "Could not move ${SESSION_DIR@Q} aside; it is left in place"
    return 1
  fi
  error "Segments preserved in: $dest/segments"
}

# create_session: create an empty session directory (start only, after the
# caller has checked that no session exists). A leftover directory with no
# state file is an interrupted start: it is moved aside, never deleted.
create_session() {
  if [[ -d "$SESSION_DIR" ]]; then
    warn 'Found an incomplete session directory; moving it aside'
    preserve_session || return 1
  fi
  mkdir -p -- "$SEGMENTS_DIR" || { error "Cannot create ${SEGMENTS_DIR@Q}"; return 1; }
}

# ============================================================================
# UTILITY FUNCTIONS
# Disk space checks, timestamp generation, file listing, process validation
# ============================================================================
# check_disk_space: fail if $1's filesystem has less than MIN_DISK_SPACE_MB free
check_disk_space() {
  local -- path=$1 available=''
  available=$(df -BM --output=avail -- "$path" 2>/dev/null | tail -n 1) || available=''
  available=${available//[!0-9]/}
  if [[ -z "$available" ]]; then
    warn "Cannot read the free space on ${path@Q}; not checked"
    return 0
  fi
  if ((available < MIN_DISK_SPACE_MB)); then
    error "Insufficient disk space on ${path@Q}: ${available}MB available, ${MIN_DISK_SPACE_MB}MB required"
    return 1
  fi
}

# Function to get timestamp for filename
get_timestamp() { date +"%Y%m%d_%H%M%S"; }

# file_size: the length of file $1, human-readable. Not its disk usage, which
# plain du reports: ZFS allocates a new file's blocks seconds after the write
# (a 327K MP3 just converted showed as 1.0K), and compression shrinks it.
file_size() { du -h --apparent-size -- "$1" | cut -f1; }

# list_recordings: Display WAV files or all files in recordings directory
list_recordings() {
  local -i show_all=${1:-0}
  
  if ((show_all)); then
    printf '%s\n' "All files in $RECORDING_DIR:"
  else
    printf '%s\n' "Available recordings in $RECORDING_DIR:"
  fi
  printf '%s\n' '----------------------------------------'
  
  local -i count=1
  local -i found=0
  local -- file basename size date ext
  
  if ((show_all)); then
    # Show all files
    for file in "$RECORDING_DIR"/*; do
      if [[ -f "$file" ]]; then
        found=1
        basename=${file##*/}
        # A file removed mid-listing must not end the listing
        size=$(file_size "$file") || size='?'
        date=$(stat -c %y -- "$file" | cut -d' ' -f1,2 | cut -d'.' -f1) || date='?'
        ext="${basename##*.}"
        printf "%2d. %-40s [%s] %-8s %s\n" "$count" "$basename" "$size" "[$ext]" "$date"
        count+=1
      fi
    done
  else
    # Show only WAV files
    if compgen -G "$RECORDING_DIR/*.wav" &>/dev/null; then
      found=1
      for file in "$RECORDING_DIR"/*.wav; do
        basename=${file##*/}
        size=$(file_size "$file") || size='?'
        date=$(stat -c %y -- "$file" | cut -d' ' -f1,2 | cut -d'.' -f1) || date='?'
        printf "%2d. %-40s [%s] %s\n" "$count" "$basename" "$size" "$date"
        count+=1
      done
    fi
  fi
  
  if ((found == 0)); then
    if ((show_all)); then
      printf '%s\n' 'No files found.'
    else
      printf '%s\n' 'No recordings found.'
    fi
  fi
  echo
}

# validate_ffmpeg_process: Check if PID is a running ffmpeg process
validate_ffmpeg_process() {
  local -- pid=$1
  
  # Check if process exists
  if ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  
  # Check if it's actually ffmpeg
  local -- cmd=''
  cmd=$(ps -p "$pid" -o comm= 2>/dev/null || echo '')
  if [[ "$cmd" != ffmpeg ]]; then
    return 1
  fi
  
  return 0
}

# session_exists: a recording session is in progress (recording or paused).
# The state file decides this: a paused session has no ffmpeg process.
session_exists() { [[ -f "$STATE_FILE" ]]; }

# recorder_alive: the session's ffmpeg is running
recorder_alive() {
  local -- pid
  pid=$(cat -- "$PID_FILE" 2>/dev/null || echo '')
  [[ -n "$pid" ]] && validate_ffmpeg_process "$pid"
}

# start_capture: record from the default source into $1 with a background
# ffmpeg, in the session's format. The state is set to 'recording' first, so
# a start interrupted at any point is still a session that status and stop
# can see. Returns 1, leaving no PID file, if ffmpeg exits at startup (e.g.
# no audio server); the caller then restores or discards the session.
start_capture() {
  local -- out_file=$1
  local -- log_file="$LOG_DIR"/ffmpeg.log
  local -- codec rate channels
  read -r codec rate channels <<<"$(session_format)"
  # Callers run this under 'if !', which disables set -e in here, so every
  # write is checked explicitly.
  check_log_before_write "$log_file" || return 1
  echo 'recording' > "$STATE_FILE" || { error "Cannot write ${STATE_FILE@Q}"; return 1; }
  # file: makes ffmpeg read the operand as a path (it accepts no --).
  # -rf64 auto: past 4 GB (about 6.7 h at the defaults) a plain WAV header
  # overflows; RF64 takes over only then. 9>&-: see acquire_lock.
  ffmpeg -f pulse -i default -acodec "$codec" -ar "$rate" -ac "$channels" \
         -rf64 auto file:"$out_file" </dev/null >/dev/null 2>>"$log_file" 9>&- &
  local -- pid=$!
  if ! echo "$pid" > "$PID_FILE"; then
    # Without a PID file nothing could stop this recorder later
    kill -TERM "$pid" 2>/dev/null || true
    error "Cannot write ${PID_FILE@Q}"
    return 1
  fi

  # Small delay allows ffmpeg to initialize or fail fast
  sleep 0.5
  if ! validate_ffmpeg_process "$pid"; then
    error "Failed to start recording! Check $log_file for details"
    rm -f -- "$PID_FILE" || warn "Could not remove ${PID_FILE@Q}"
    return 1
  fi

  # Informational only (status shows its size)
  echo "$out_file" > "$SESSION_DIR"/current_file || warn "Cannot write ${SESSION_DIR@Q}/current_file"
}

# stop_capture: end the running ffmpeg with SIGTERM so it finalises the WAV
# header, forcing SIGKILL after 10 s. A no-op when no recorder is running.
stop_capture() {
  local -- pid
  pid=$(cat -- "$PID_FILE" 2>/dev/null || echo '')
  if [[ -n "$pid" ]] && validate_ffmpeg_process "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    local -i wait_count=0
    while kill -0 "$pid" 2>/dev/null && ((wait_count < 20)); do
      sleep 0.5
      wait_count+=1
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "Process didn't stop cleanly, forcing..."
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f -- "$PID_FILE" || warn "Could not remove ${PID_FILE@Q}"
}

# get_last_recording: Find the most recently modified WAV file
# A plain loop, not 'find | sort | head -n1': under pipefail that pipeline died
# with SIGPIPE (exit 141) once the listing outgrew one pipe write (~100 WAVs).
# -nt compares mtimes to the nanosecond and handles any filename.
get_last_recording() {
  local -- file last_file=''
  for file in "$RECORDING_DIR"/*.wav; do
    [[ -f "$file" ]] || continue
    [[ -n "$last_file" && ! "$file" -nt "$last_file" ]] || last_file=$file
  done
  echo "$last_file"
}

# ============================================================================
# LOG MANAGEMENT
# ffmpeg.log, merge.log and mp3_convert.log in $LOG_DIR, appended across
# sessions: rotated at LOG_MAX_SIZE_MB, LOG_MAX_FILES compressed copies kept
# ============================================================================
# rotate_log: when $1 has reached LOG_MAX_SIZE_MB, shift $1.N.gz to $1.N+1.gz
# (dropping the oldest), compress $1 to $1.1.gz and empty it
rotate_log() {
  local -- log_file=$1
  local -i max_size_bytes=$((LOG_MAX_SIZE_MB * 1024 * 1024)) file_size=0 i

  [[ -f "$log_file" ]] || return 0
  file_size=$(stat -c %s -- "$log_file" 2>/dev/null || echo 0)
  ((file_size >= max_size_bytes)) || return 0

  debug "Rotating log file: $log_file (size: $file_size bytes)"
  rm -f -- "$log_file.$LOG_MAX_FILES.gz" || warn "Could not remove ${log_file@Q}.$LOG_MAX_FILES.gz"
  for ((i = LOG_MAX_FILES - 1; i >= 1; i-=1)); do
    [[ ! -f "$log_file.$i.gz" ]] \
      || mv -f -- "$log_file.$i.gz" "$log_file.$((i + 1)).gz" \
      || warn "Could not rotate ${log_file@Q}.$i.gz"
  done
  if gzip -c -- "$log_file" > "$log_file.1.gz"; then
    : > "$log_file" || warn "Could not empty ${log_file@Q} after rotating it"
  else
    warn "Could not compress ${log_file@Q}; it keeps growing"
  fi
}

# clean_old_logs: Remove log files older than 30 days from $LOG_DIR. Session
# directories are never reaped: they may hold audio that is not yet merged.
clean_old_logs() {
  [[ -d "$LOG_DIR" ]] || return 0
  find -- "$LOG_DIR" -name '*.log*' -type f -mtime +30 -delete 2>/dev/null || true
}

# check_log_before_write: create $LOG_DIR if needed and rotate log $1
check_log_before_write() {
  local -- log_file=$1
  [[ -d "$LOG_DIR" ]] || mkdir -p -- "$LOG_DIR" \
    || { error "Cannot create log directory ${LOG_DIR@Q}"; return 1; }
  rotate_log "$log_file"
}

# ============================================================================
# BEEP NOTIFICATIONS
# Periodic audio reminders during active recording (via ffplay)
# ============================================================================
beep_loop() {
  # Check if beep is enabled
  if ((BEEP_ENABLED == 0 || NO_BEEP == 1)); then
    return 0
  fi
  
  # Search for beep file in multiple locations
  local -a beep_locations=(
    "$BEEP_FILE"  # User configured location
    "$STATE_DIR"/beep.mp3  # User's state directory
    /usr/local/share/vrecord/beep.mp3  # System installation
    /usr/share/vrecord/beep.mp3  # Alternative system location
    "${SCRIPT_PATH%/*}"/beep.mp3  # Same directory as script
  )

  local -i found=0
  local -- location
  for location in "${beep_locations[@]}"; do
    if [[ -f "$location" ]]; then
      BEEP_FILE="$location"
      found=1
      debug "Using beep file ${BEEP_FILE@Q}"
      break
    fi
  done

  if ((found == 0)); then
    debug 'Beep file not found in any standard location'
    return 0
  fi
  
  # Check if ffplay is available
  if ! command -v ffplay &>/dev/null; then
    debug 'ffplay not found, beep notifications disabled'
    return 0
  fi

  # Each child (player or sleep) runs in the background and is waited for:
  # the TERM from stop_beep_process then interrupts the wait at once, and the
  # trap ends the child too. A foreground child would be left running. The
  # child may have exited already: '|| :' keeps that failed kill (under set -e)
  # from ending the trap with status 1 instead of 143.
  local -i child=0
  local -- state
  trap '((child == 0)) || kill -- "$child" 2>/dev/null || :; exit 143' TERM

  # Runs while the session exists; beeps only while recording (not paused)
  while [[ -f "$STATE_FILE" ]]; do
    state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')
    if [[ "$state" == recording ]]; then
      ffplay -nodisp -autoexit -loglevel quiet file:"$BEEP_FILE" &
      child=$!
      # A player that fails (no output device, a bad beep file) would fail
      # every time: end the loop rather than retry it every interval
      wait "$child" || exit 1
      sleep "$BEEP_INTERVAL" &
    else
      sleep 5 &
    fi
    child=$!
    wait "$child" || exit 1
  done
}

# start_beep_process: Start the beep notification background process
start_beep_process() {
  # Check if beep is enabled
  if ((BEEP_ENABLED == 0 || NO_BEEP == 1)); then
    return 0
  fi
  # 'sleep 0' returns at once, so a zero interval would beep nonstop
  if ((BEEP_INTERVAL < 1)); then
    warn "BEEP_INTERVAL must be a whole number of seconds above 0; beeps are off"
    return 0
  fi
  
  # Check if already running
  if [[ -f "$BEEP_PID_FILE" ]]; then
    local -- pid
    pid=$(cat -- "$BEEP_PID_FILE" 2>/dev/null || echo '')
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      debug "Beep process already running: $pid"
      return 0
    fi
  fi
  
  # Start beep loop in background, holding none of this run's descriptors:
  # an inherited stdout/stderr made '$(vrecord start)' wait for the whole
  # recording, and FD 9 is the lock (see acquire_lock)
  beep_loop </dev/null &>/dev/null 9>&- &
  local -- beep_pid=$!
  if ! write_state "$BEEP_PID_FILE" "$beep_pid"; then
    # Untracked, stop could not end it: beeps are a reminder, not worth that
    kill -- "$beep_pid" 2>/dev/null || true
    warn 'Beep reminders are off for this recording'
    return 0
  fi
  debug "Started beep process: $beep_pid"
}

# stop_beep_process: Stop the beep notification background process
stop_beep_process() {
  if [[ -f "$BEEP_PID_FILE" ]]; then
    local -- pid
    pid=$(cat -- "$BEEP_PID_FILE" 2>/dev/null || echo '')
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      debug "Stopped beep process: $pid"
    fi
    rm -f -- "$BEEP_PID_FILE" || warn "Could not remove ${BEEP_PID_FILE@Q}"
  fi
}

# ============================================================================
# RECORDING CONTROL
# Core operations: start, pause, resume, stop, merge, convert
# ============================================================================

# start_recording: Begin new recording or continue an existing WAV file
# New recordings: create ${prefix}_TIMESTAMP.wav in RECORDING_DIR
# Resume/continue: record new segments to SESSION_DIR/segments/, merge on stop
# Args: $1=prefix, $2=resume_file, $3=continue_last_flag
start_recording() {
  local -- filename_prefix=${1:-$DEFAULT_PREFIX}
  local -- resume_file=${2:-}
  local -i continue_last=${3:-0}

  # Validate the prefix of a new recording, DEFAULT_PREFIX included: it comes
  # from config files and the environment, and becomes part of a path
  if [[ -z "$resume_file" ]] && ((continue_last == 0)); then
    validate_safe_filename "$filename_prefix" 0 || return 1
  fi

  # Validate resume file if provided
  if [[ -n "$resume_file" ]]; then
    if ! validate_safe_filename "$resume_file" 1; then
      return 1
    fi
  fi

  check_dependencies
  acquire_lock || return 1
  init_session
  
  local -- output_file='' format=''

  # Check disk space
  check_disk_space "$RECORDING_DIR" || return 1
  check_disk_space "$STATE_DIR" || return 1  # resume segments live here

  # Check if directory is writable
  if [[ ! -w "$RECORDING_DIR" ]]; then
    error "Recording directory is not writable ${RECORDING_DIR@Q}"
    return 1
  fi

  # Handle continue-last flag
  if ((continue_last)); then
    resume_file=$(get_last_recording)
    if [[ -z "$resume_file" ]]; then
      error 'No recordings found to continue!'
      return 1
    fi
    info "Continuing last recording '${resume_file##*/}'"
  fi
  
  # Check if we're resuming an existing file
  if [[ -n "$resume_file" ]]; then
    if [[ -f "$resume_file" ]]; then
      # Validate full path is within recording directory
      if ! validate_recording_path "$resume_file"; then
        return 1
      fi
      # File exists, good to go
      true
    elif [[ -f "$RECORDING_DIR/$resume_file" ]]; then
      resume_file="$RECORDING_DIR/$resume_file"
      # Validate constructed path
      if ! validate_recording_path "$resume_file"; then
        return 1
      fi
    else
      error "File ${resume_file@Q} not found!" \
            "Use 'list' command to see available recordings."
      return 1
    fi
  fi

  if recorder_alive; then
    error 'Recording is already in progress!'
    return 1
  fi
  # Never replace an existing session: a paused one has no recorder process,
  # and an interrupted one (ffmpeg crashed) still holds unmerged audio.
  if session_exists; then
    if [[ $(cat -- "$STATE_FILE" 2>/dev/null) == paused ]]; then
      error 'A recording is paused.' \
            "Use '$SCRIPT_NAME resume' to continue it or '$SCRIPT_NAME stop' to finish it."
    else
      error 'The previous recording was interrupted (its recorder is no longer running).' \
            "Run '$SCRIPT_NAME stop' to save it, then start again."
    fi
    return 1
  fi

  # New audio for an existing recording is recorded in that recording's format
  if [[ -n "$resume_file" ]]; then
    format=$(probe_wav "$resume_file") || return 1
  else
    format="$AUDIO_FORMAT $SAMPLE_RATE $CHANNELS"
  fi
  create_session || return 1

  local -- capture_file=''
  local -i segment_count
  if [[ -n "$resume_file" ]]; then
    # Resuming existing recording: the new audio is segment 1 of a new session
    output_file="$resume_file"
    info "Resuming recording '${output_file##*/}'" \
         "Original file size: $(file_size "$output_file")"
    capture_file="$SEGMENTS_DIR"/segment_1.wav
    segment_count=1
    info "Recording new segment ${capture_file@Q}"
  else
    # New recording. Remove a trailing underscore to avoid a double one.
    filename_prefix="${filename_prefix%_}"
    output_file="$RECORDING_DIR/${filename_prefix}_$(get_timestamp).wav"
    info 'Starting new recording...' \
         "Output file ${output_file@Q}"
    segment_count=0
    capture_file=$output_file
  fi

  # The session files: stop runs as a separate invocation and acts on these.
  # The main file is what segments are merged into, and what stop reports.
  # The session was created by this run and holds no audio yet, so if a
  # write or the capture fails, discard it.
  if ! { write_state "$SEGMENT_COUNT_FILE" "$segment_count" \
          && write_state "$SESSION_DIR"/main_file "$output_file" \
          && write_state "$FORMAT_FILE" "$format" \
          && { ((TRANSCRIBE == 0)) || write_state "$TRANSCRIBE_FILE" 1; } \
          && { ((NO_MP3 == 0)) || write_state "$NO_MP3_FILE" 1; }; }; then
    cleanup_files
    return 1
  fi

  if ! start_capture "$capture_file"; then
    cleanup_files
    return 1
  fi

  info "Recording started. PID: $(cat -- "$PID_FILE")" \
       "Use '$SCRIPT_NAME stop' to stop recording"
  
  # Start beep notifications
  start_beep_process
       
  release_lock
}

# pause_recording: End the current segment; resume_recording() starts a new
# one, and stop merges them. ffmpeg is not SIGSTOPped: a stopped recorder
# leaves the audio server buffering, and up to ~24 s of "paused" audio was
# handed over on resume and recorded.
pause_recording() {
  acquire_lock || return 1
  init_session

  session_exists || { error 'No active recording found!'; release_lock; return 1; }

  local -- state
  state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')

  if [[ "$state" == paused ]]; then
    error 'Recording is already paused!'
    release_lock
    return 1
  fi

  if recorder_alive; then
    info 'Pausing recording...'
    # Stop beep notifications while paused
    stop_beep_process
    stop_capture
    # If this fails the session reads as interrupted, and stop still saves it
    write_state "$STATE_FILE" paused || { release_lock; return 1; }

    info "Recording paused. Use 'resume' to continue."
  else
    # The recorder is gone; finalize and recover any segments rather than
    # deleting them (the old code ran cleanup_files here, losing the audio).
    finalize_orphaned_session || return 1
    return 0
  fi

  release_lock
}

# resume_recording: Record a new segment after a pause (merged on stop)
resume_recording() {
  acquire_lock || return 1
  init_session

  if ! session_exists; then
    error 'No active recording found!'
    release_lock
    return 1
  fi

  local -- state
  state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')

  if [[ "$state" == recording ]]; then
    error 'Recording is already active!'
    release_lock
    return 1
  fi

  # The segment count advances only once ffmpeg is confirmed running, so a
  # failed resume leaves the session paused and intact.
  local -i segment_count=0
  segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')
  segment_count+=1
  local -- segment_file="$SEGMENTS_DIR"/segment_"$segment_count".wav

  info 'Resuming recording...'
  if ! start_capture "$segment_file"; then
    rm -f -- "$segment_file" || warn "Could not remove ${segment_file@Q}"
    write_state "$STATE_FILE" paused || true
    release_lock
    return 1
  fi
  # A segment the count leaves out is not merged (and the merge then deletes
  # it): if the count cannot be saved, undo the resume
  if ! write_state "$SEGMENT_COUNT_FILE" "$segment_count"; then
    stop_capture
    rm -f -- "$segment_file" || warn "Could not remove ${segment_file@Q}"
    write_state "$STATE_FILE" paused || true
    release_lock
    return 1
  fi

  # Restart beep notifications
  start_beep_process

  info 'Recording resumed.'
  release_lock
}

# concat_entry: print the ffmpeg concat-list line for path $1. Inside '...'
# nothing is special, so a quote is written '\'' (close, escaped quote,
# reopen). A newline cannot be written at all: the list is line-based.
concat_entry() {
  local -- quote="'\\''"
  [[ "$1" != *$'\n'* ]] || { error "Cannot merge a path containing a newline: ${1@Q}"; return 1; }
  printf "file '%s'\n" "${1//\'/$quote}"
}

# merge_segments: Combine original file with recorded segments using ffmpeg
# Uses ffmpeg concat demuxer with a filelist.txt containing:
#   file '/path/to/original.wav'
#   file '/path/to/segment_1.wav'
#   ...
# Segments are removed after successful merge; preserved on failure for recovery
merge_segments() {
  local -- main_file=$1
  local -i segment_count=0
  segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  ((segment_count)) || return 0  # No segments to merge
  # With no main file the segments cannot be merged: fail, so the caller
  # keeps them (preserve_session) instead of cleaning the session up
  [[ -n "$main_file" ]] || { error 'This session has no main recording to merge into'; return 1; }

  info 'Merging segments with original recording...'

  # Concat demuxer input: the main file, then each segment in order
  local -- filelist="$SESSION_DIR"/filelist.txt
  concat_entry "$main_file" > "$filelist" || return 1
  local -i i
  local -- segment_file
  for ((i=1; i<=segment_count; i+=1)); do
    segment_file="$SEGMENTS_DIR"/segment_"$i".wav
    if [[ -f "$segment_file" ]]; then
      concat_entry "$segment_file" >> "$filelist" || return 1
    fi
  done

  # Merge into a temp file beside the main file, so replacing it is an atomic
  # same-filesystem rename, never a copy that an interruption could truncate.
  # Dot-prefixed and not *.wav, so list/play/start -c ignore it; -f wav because
  # the name has no .wav extension. mktemp creates it 0600, so the original
  # recording's mode is copied onto it before the rename.
  local -- temp_merged
  temp_merged=$(mktemp -- "${main_file%/*}"/.vrecord-merge.XXXXXX) || {
    error "Cannot create a merge file beside ${main_file@Q}"
    return 1
  }
  MERGE_TEMP=$temp_merged

  local -- log_file="$LOG_DIR"/merge.log
  check_log_before_write "$log_file" || return 1
  # file: makes ffmpeg read the operand as a path (it accepts no --);
  # -rf64 auto: see start_capture
  if ffmpeg -y -f concat -safe 0 -i file:"$filelist" -c copy -f wav -rf64 auto file:"$temp_merged" \
            </dev/null >/dev/null 2>>"$log_file"; then
    chmod --reference="$main_file" -- "$temp_merged" \
      || warn "Could not copy the permissions of ${main_file@Q}"
    # Replace original with merged version
    mv -f -- "$temp_merged" "$main_file" || {
      MERGE_TEMP=''  # the merged output is the only complete copy: keep it
      error "Failed to replace ${main_file@Q} with merged output (kept ${temp_merged@Q})"
      return 1
    }
    MERGE_TEMP=''
    info "Successfully merged segments into ${main_file@Q}"

    # Clean up segment files. The merge itself succeeded: a failure here must
    # not become the return status, or stop would move the session aside.
    rm -f -- "$SEGMENTS_DIR"/segment_*.wav "$filelist" \
      || warn 'Could not remove the merged segment files'
    return 0
  else
    rm -f -- "$temp_merged" || warn "Could not remove the partial merge ${temp_merged@Q}"
    MERGE_TEMP=''
    error 'Error: Failed to merge segments!' \
          "Original file preserved: $main_file"
    return 1
  fi
}

# finalize_orphaned_session: pause found the recorder gone (crash / OOM /
# external kill). Merge any resume segments into the original BEFORE cleanup
# so freshly recorded audio is not lost, then clear session state and release
# the lock. Returns 1 on merge failure, after moving the session aside to
# $STATE_DIR/recovered_*; 0 otherwise.
finalize_orphaned_session() {
  warn 'Recording process not found (it may have already exited).'
  stop_beep_process

  local -- main_file=''
  main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null || echo '')
  local -i segment_count=0
  segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  if ((segment_count > 0)); then
    merge_segments "$main_file" || {
      error "Merge failed - segments kept for recovery; see $LOG_DIR/merge.log"
      preserve_session || true
      release_lock
      return 1
    }
  fi

  cleanup_files
  release_lock
  return 0
}

# stop_recording: End the session and finalize its recording. Ends the
# recorder if one is running (a paused or interrupted session has none) and
# merges any segments, under the lock. The session is then removed and the
# lock released BEFORE the MP3 conversion and transcription (-t), which can
# take minutes; nothing after that point touches the session. Prints the
# saved WAV path on stdout.
stop_recording() {
  acquire_lock || return 1
  init_session

  if ! session_exists; then
    error 'No active recording found!'
    release_lock
    return 1
  fi

  local -- state main_file
  local -i segment_count=0
  state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')
  main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null || echo '')
  segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  stop_beep_process
  if [[ "$state" == paused ]] || recorder_alive; then
    info 'Stopping recording...'
    stop_capture
    info 'Recording stopped.'
  else
    # The recorder died (crash, OOM kill, reboot): save what it recorded
    warn 'Recording process not found (it may have already exited).'
    rm -f -- "$PID_FILE" || warn "Could not remove ${PID_FILE@Q}"
  fi

  # Guard with || so a merge failure cannot trip set -e. On failure the
  # session is moved aside (never deleted), so a new recording can start.
  if ((segment_count > 0)); then
    merge_segments "$main_file" || {
      error "Merge failed - segments kept for recovery; see $LOG_DIR/merge.log"
      preserve_session || true
      release_lock
      return 1
    }
  fi

  # The audio is safe in main_file. Read the post-processing flags (-n and
  # -t given to start count as well), then end the session and unlock.
  [[ ! -f "$NO_MP3_FILE" ]] || NO_MP3=1
  [[ ! -f "$TRANSCRIBE_FILE" ]] || TRANSCRIBE=1
  cleanup_files
  release_lock

  if [[ -z "$main_file" || ! -f "$main_file" ]]; then
    warn "No recording file was found${main_file:+ at ${main_file@Q}}"
    return 0
  fi
  info "Recording saved to ${main_file@Q}"
  if command -v mediainfo &>/dev/null; then
    info 'File info:'
    mediainfo -- "$main_file" 2>/dev/null | grep -E '(Duration|File size)' >&2 || true
  else
    info "File size: $(file_size "$main_file")"
  fi

  # Transcription runs on the MP3, so -n also skips it
  if ((NO_MP3 == 0)); then
    convert_to_mp3 "$main_file" || warn 'MP3 conversion failed; WAV is intact.'
  elif ((TRANSCRIBE)); then
    warn 'Transcription skipped: it runs on the MP3, and --no-mp3 is in effect.'
  fi

  # Report the saved recording on stdout (all messages go to stderr), so
  # callers such as vrecord-loop never have to guess which file was written.
  printf '%s\n' "$main_file"
}

# convert_to_mp3: Convert WAV recording $1 to MP3, then transcribe it if
# TRANSCRIBE is set. Touches no session file: stop has ended the session.
convert_to_mp3() {
  local -- wav_file=$1
  local -- mp3_file="${wav_file%.wav}".mp3
  local -- log_file="$LOG_DIR"/mp3_convert.log

  if ! command -v ffmpeg &>/dev/null; then
    warn "ffmpeg not found, skipping MP3 conversion"
    return 1
  fi

  info "Converting to MP3: ${mp3_file##*/}"
  check_log_before_write "$log_file" || return 1
  if ffmpeg -y -i file:"$wav_file" -codec:a libmp3lame -b:a "$MP3_BITRATE" file:"$mp3_file" \
            </dev/null >/dev/null 2>>"$log_file"; then
    success "MP3 created: $mp3_file"
    info "MP3 size: $(file_size "$mp3_file")"

    # Run transcription if requested and transcribe command is available
    if ((TRANSCRIBE)); then
      if command -v transcribe &>/dev/null; then
        info "Running transcription on: ${mp3_file##*/}"
        # stdout is reserved for stop's result line (the saved WAV path)
        if transcribe -- "$mp3_file" >&2; then
          success 'Transcription completed'
        else
          warn 'Transcription failed'
        fi
      else
        warn 'Transcribe command not found, skipping transcription'
      fi
    fi
  else
    error 'Failed to convert to MP3' \
          "Check $log_file for details"
    return 1
  fi
}

# show_status: print the session state on stdout -- recording, paused,
# interrupted or idle -- and the details on stderr. Exit status, as in LSB
# init scripts: 0 recording or paused, 1 interrupted (the recorder died; the
# session is kept for 'stop'), 3 idle. Read-only: takes no lock, changes nothing.
show_status() {
  init_session

  if ! session_exists; then
    printf '%s\n' idle
    info 'No active recording'
    return 3
  fi

  local -- state main_file current_file size last_error=''
  local -i segment_count=0
  state=$(cat -- "$STATE_FILE" 2>/dev/null || echo 'unknown')
  main_file=$(cat -- "$SESSION_DIR"/main_file 2>/dev/null || echo '')
  current_file=$(cat -- "$SESSION_DIR"/current_file 2>/dev/null || echo '')
  segment_count=$(cat -- "$SEGMENT_COUNT_FILE" 2>/dev/null || echo '0')

  if [[ "$state" != paused ]] && ! recorder_alive; then
    # The recorder died (crash, OOM kill, reboot). Leave everything in place
    # so 'stop' can merge what was recorded.
    printf '%s\n' interrupted
    error 'Recording interrupted: the recorder process is no longer running.' \
          "Main file: $main_file" \
          "Run '$SCRIPT_NAME stop' to save what was recorded."
    return 1
  fi

  printf '%s\n' "$state"
  [[ "$state" == paused ]] || info "PID: $(cat -- "$PID_FILE")"
  info "Main file: $main_file"
  if ((segment_count > 0)); then
    size=$(file_size "$main_file" 2>/dev/null) || size=''
    info "Resume segments: $segment_count" "Original file size: ${size:-Unknown}"
  fi
  if [[ -f "$current_file" ]]; then
    size=$(file_size "$current_file" 2>/dev/null) || size=''
    if ((segment_count > 0)); then
      info "Current segment size: ${size:-Unknown}"
    else
      info "Current file size: ${size:-Unknown}"
    fi
  fi

  # Report a recent recorder error (the log is shared by all sessions, so only
  # its last lines are read)
  if [[ "$state" == recording && -s "$LOG_DIR"/ffmpeg.log ]]; then
    last_error=$(tail -n 5 -- "$LOG_DIR"/ffmpeg.log 2>/dev/null | grep -i error | tail -n 1) \
      || last_error=''
    [[ -z "$last_error" ]] || warn "Recent error: $last_error"
  fi
}

# cleanup_files: End the session by removing its directory. Called only once
# its audio is safe: merged into the main file, or never recorded.
cleanup_files() {
  # Stop beep process if running
  stop_beep_process

  if [[ -n "$SESSION_DIR" && -d "$SESSION_DIR" ]]; then
    rm -rf -- "$SESSION_DIR" || warn "Could not remove ${SESSION_DIR@Q}"
  fi
}

# show_help: Display usage information
show_help() {
  cat <<HELP
vrecord - Voice Recorder with Resume Capability

Usage: $SCRIPT_NAME [options] <command> [args]

Commands:
  start [PREFIX]    Start new recording (default prefix: voice_recording)
  start -c          Continue the most recent recording
  start -r FILE     Resume a specific WAV file
  pause             Pause recording (ends the current segment)
  resume            Resume recording into a new segment (merged on stop)
  stop              Stop recording, create MP3; prints the saved WAV path on stdout
  status            Print the state on stdout (recording, paused, interrupted or
                    idle), details on stderr; exit 0 recording/paused,
                    1 interrupted, 3 idle
  list [--all]      List WAV files (or all files with --all)
  play [FILE]       Play a recording (most recent if FILE omitted; .wav optional)
  help              Show this help

Start Options:
  -c, --continue-last   Append to the most recent WAV file
  -r, --resume FILE     Append to a specific WAV file (PCM WAV only; new audio
                        is recorded at that file's sample rate and channels)
  -t, --transcribe      Transcribe after MP3 conversion

Stop Options:
  -t, --transcribe      Transcribe the MP3 file

Global Options:
  -n, --no-mp3     Skip MP3 conversion (and so transcription)
  -b, --no-beep    Disable periodic beep reminders
  -v, --verbose    Also show debug messages
  -q, --quiet      Suppress non-error output
  -h, --help       Show this help
  -V, --version    Show version
  Short options can be bundled: start -tn is start -t -n.

Examples:
  # Basic workflow
  $SCRIPT_NAME start meeting       # → meeting_20250120_143052.wav
  $SCRIPT_NAME pause               # Pause recording
  $SCRIPT_NAME resume              # Resume recording
  $SCRIPT_NAME stop                # → meeting_20250120_143052.mp3

  # Continue previous recording
  $SCRIPT_NAME start -c            # Append to most recent WAV

  # Play a recording
  $SCRIPT_NAME play                # Play the most recent recording
  $SCRIPT_NAME play meeting_20250120_143052   # Specific file (.wav optional)

  # Record with transcription
  $SCRIPT_NAME start -t notes      # Start with transcribe flag
  $SCRIPT_NAME stop                # Stop, convert, transcribe

  # Skip MP3 conversion
  $SCRIPT_NAME -n start interview  # Record WAV only
  $SCRIPT_NAME stop --no-mp3       # Or specify at stop time

Paths:
  Recordings: $RECORDING_DIR
  State:      $STATE_DIR
  Logs:       $LOG_DIR

Recording continues in background after script exits.
Use 'status' to check state and 'stop' to finalize.
HELP
  exit 0
}


# ============================================================================
# COMMAND-LINE PARSING
# Global options first, then command with command-specific options
# ============================================================================
parse_args() {
  local -a args=()
  local -- command=''

  # Standard argument parsing pattern
  while (($#)); do case $1 in
    -n|--no-mp3)     NO_MP3=1 ;;
    -b|--no-beep)    NO_BEEP=1 ;;
    -v|--verbose)    VERBOSE+=1 ;;
    -q|--quiet)      VERBOSE=0 ;;
    -h|--help|help)  show_help ;;
    -V|--version)    echo "$SCRIPT_NAME $VERSION"
                     cat >&2 <<'EOF'
Copyright (C) 2024 Open Technology Foundation
License: GPL-3.0-or-later <https://gnu.org/licenses/gpl.html>
This is free software: you are free to change and redistribute it.
There is NO WARRANTY, to the extent permitted by law.
EOF
                     exit 0 ;;
    # Split a bundle (-tn -> -t -n) on any flag that takes no argument; the
    # command options -t and -c then go on to the command's own parser.
    # -r takes a file, so -rNAME is left whole.
    -[nbvqhVtc]?*)   set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;

    -*)
      # Unknown option - save for command processing
      args+=("$1") ;;
    *)
      # This is the command or a command argument
      if [[ -z "$command" ]]; then
        command=$1
      else
        args+=("$1")
      fi ;;
  esac; shift; done

  # If no command given, show help
  [[ -n "$command" ]] || show_help

  # Process the command with remaining arguments
  process_command "$command" ${args[@]+"${args[@]}"}
}

# play_recording: Play a recording with xdg-open
# No argument plays the most recent WAV; a bare name is resolved in
# RECORDING_DIR and the .wav extension is optional.
play_recording() {
  local -- file=${1:-}
  local -- target=''

  command -v xdg-open &>/dev/null \
    || { error 'xdg-open not found (install xdg-utils to use play)'; return 1; }

  if [[ -z "$file" ]]; then
    # No argument: play the most recently modified recording
    target=$(get_last_recording)
    [[ -n "$target" ]] || { error 'No recordings found to play.'; return 1; }
  else
    # Reject unsafe names / traversal before touching the filesystem
    validate_safe_filename "$file" 1 || return 1
    # A bare name (no directory component) is resolved in RECORDING_DIR
    [[ "$file" == */* ]] || file="$RECORDING_DIR/$file"
    # The .wav extension is optional
    if [[ ! -f "$file" && -f "$file.wav" ]]; then
      file="$file.wav"
    fi
    target=$file
  fi

  # Keep playback within the recording directory (same guard as resume)
  validate_recording_path "$target" || return 1
  [[ -f "$target" ]] || { error "Recording not found: ${target@Q}"; return 1; }

  info "Playing ${target@Q}"
  # xdg-open takes no --. The target cannot begin with a dash: it is under
  # RECORDING_DIR, made absolute at startup, or a relative name that
  # validate_safe_filename passed, and that refuses a leading dash.
  #bcscheck disable=BCS1005
  xdg-open "$target" || { error "Failed to play ${target@Q}"; return 1; }
}

# process_command: Execute the requested command with its arguments
process_command() {
  local -- command=$1
  shift
  
  case $command in
    start)
      local -- prefix=''
      local -- resume_file=''
      local -i continue_last=0

      # Parse start command options
      while (($#)); do
        case "$1" in
          -c|--continue-last)
            continue_last=1 ;;
          -r|--resume)
            [[ -n "${2:-}" ]] || die 2 '--resume requires a filename'
            resume_file=$2
            # Validate resume filename
            validate_safe_filename "$resume_file" 1 || die 2 'Invalid resume filename'
            shift ;;
          -t|--transcribe)
            TRANSCRIBE=1 ;;
          -*)
            die 2 "Unknown option for start: ${1@Q}" ;;
          *)
            # This is the prefix
            [[ -z "$prefix" ]] || die 2 'Too many arguments for start command'
            prefix="$1"
            # Validate prefix
            validate_safe_filename "$prefix" 0 || die 2 'Invalid filename prefix' ;;
      esac; shift; done
      
      # Validate conflicting options
      if ((continue_last)) && [[ -n "$resume_file" ]]; then
        die 2 'Cannot use both --continue-last and --resume'
      fi
      
      # Validation: prefix not allowed with continue/resume
      # When continuing/resuming, the filename is already determined
      if [[ -n "$prefix" ]] && { ((continue_last)) || [[ -n "$resume_file" ]]; }; then
        die 2 'Cannot specify filename prefix when continuing/resuming a recording'
      fi
      
      start_recording "$prefix" "$resume_file" "$continue_last"
      ;;
    pause)
      pause_recording
      ;;
    resume)
      resume_recording
      ;;
    stop)
      # Parse stop command options
      while (($#)); do case $1 in
        -t|--transcribe)  TRANSCRIBE=1 ;;
        -*)               die 2 "Unknown option for stop: ${1@Q}" ;;
        *)                die 2 "Unexpected argument for stop: ${1@Q}" ;;
      esac; shift; done
      stop_recording
      ;;
    status)
      show_status
      ;;
    list)
      local -i show_all=0
      
      # Parse list options
      while (($#)); do case $1 in
        --all)  show_all=1 ;;
        -*)     die 2 "Unknown option for list: ${1@Q}" ;;
        *)      die 2 "Unknown argument for list: ${1@Q}" ;;
      esac; shift; done
      
      list_recordings "$show_all"
      ;;
    play)
      local -- play_file=''
      while (($#)); do case $1 in
        -*)  die 2 "Unknown option for play: ${1@Q}" ;;
        *)   [[ -z "$play_file" ]] || die 2 'Too many arguments for play command'
             play_file=$1 ;;
      esac; shift; done
      play_recording "$play_file"
      ;;
    *)
      die 2 "Unknown command ${command@Q}. Use '$SCRIPT_NAME help' for usage."
      ;;
  esac
}

# ============================================================================
# MAIN ENTRY POINT
# ============================================================================
main() {
  clean_old_logs
  
  # Parse arguments and execute command
  parse_args "$@"
}

# Execute main function with all command-line arguments
main "$@"
