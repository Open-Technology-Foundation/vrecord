#!/usr/bin/env bash
# vrecord-loop - Quick voice recording with transcription
# Interactive loop: record, transcribe, display, repeat
set -euo pipefail
shopt -s inherit_errexit shift_verbose extglob nullglob

# The caller's PATH, kept for CALL_APP alone: that is the user's own command,
# so it is found the way the user's shell would find it
declare -r CALLER_PATH=$PATH
# Fixed PATH for the loop's own commands (vrecord, transcribe, coreutils), so
# an inherited PATH cannot substitute them. ~/.local/bin is where
# 'install.sh --user' puts vrecord.
declare -rx PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

declare -r VERSION=1.3.1
#shellcheck disable=SC2155 # realpath of the running script cannot fail
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# Configuration (can be modified by arguments or environment)
declare -- CALL_APP=${CALL_APP:-}  # Optional: command to receive transcription (stdin or {{FILE}})

# Runtime flags. VERBOSE may come from the environment: anything but a whole
# number is replaced before declare -i evaluates it ('HOME[$(cmd)]' runs cmd).
[[ ${VERBOSE:-} =~ ^(0|[1-9][0-9]*)$ ]] || VERBOSE=1
declare -i VERBOSE
declare -i RECORDING=0  # 1 while a recording this loop started may be running

# Color Definitions
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' YELLOW='' CYAN='' NC=''
fi

# Utility Functions
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    info)    prefix+=" ${CYAN}◉${NC}" ;;
    warn)    prefix+=" ${YELLOW}▲${NC}" ;;
    error)   prefix+=" ${RED}✗${NC}" ;;
    *)       ;;
  esac
  for msg in "$@"; do printf '%s %s\n' "$prefix" "$msg"; done
}

info() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
warn() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
error() { >&2 _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }
noarg() { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

show_help() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Quick voice recording with transcription

Usage: $SCRIPT_NAME [Options] [--] [prefix]

Options:
  -C, --call CMD         Command to receive transcription (overrides CALL_APP)
  -v, --verbose          Enable verbose output (default)
  -q, --quiet            Disable verbose output
  -h, --help             Display this help message
  -V, --version          Display version information

Arguments:
  prefix                 Recording filename prefix (default: voice); letters,
                         digits, dots, underscores, hyphens; no leading dot
                         or hyphen

Environment:
  CALL_APP               Command to receive transcription, run by bash. The
                         transcript is piped to its stdin by default; with a
                         {{FILE}} placeholder ('myapp {{FILE}}') it gets the
                         transcript's path instead.

Ctrl-C (or SIGTERM) stops the current recording and saves it as a WAV.

Requires: vrecord; transcribe (for transcripts)
HELP
}

check_prerequisites() {
  command -v vrecord &>/dev/null || die 1 'Required command not found: vrecord'
  command -v transcribe &>/dev/null \
    || warn 'transcribe not found: recordings will be saved but not transcribed'
}

# check_not_recording: refuse to start over a session in progress. 'vrecord
# status' exits 3 when idle (0 recording or paused, 1 interrupted).
check_not_recording() {
  local -i rc=0
  vrecord status &>/dev/null || rc=$?
  ((rc == 3)) || die 1 'A recording is in progress, paused or interrupted. Run "vrecord status".'
}

# validate_prefix: vrecord's own rule. The first character may not be a dash
# (vrecord would read the prefix as an option: '-c' means continue-last) or a
# dot (a hidden recording, which list, start -c and play never see).
validate_prefix() {
  local -- prefix=$1
  [[ "$prefix" =~ ^[a-zA-Z0-9_][a-zA-Z0-9._-]*$ ]] \
    || die 22 'Invalid prefix: alphanumeric, dots, underscores and hyphens only, not starting with a dot or hyphen'
}

# on_signal: on Ctrl-C or SIGTERM, save a recording this loop started (as a
# WAV only: no time for MP3 or transcription), then exit with 128+signal.
# Ctrl-C also reaches a running vrecord; if that leaves its session behind
# (e.g. stopped mid-merge), status reports it and it is saved here.
on_signal() {
  local -i code=$1 rc=0
  trap - INT TERM
  >&2 echo
  if ((RECORDING)); then
    vrecord status &>/dev/null || rc=$?
    if ((rc != 3)); then
      warn 'Interrupted - saving the recording (WAV only).'
      vrecord -q -n stop >/dev/null || error 'Could not stop the recording. Run "vrecord stop".'
    fi
  fi
  exit "$code"
}

# read_key: read one key press into the variable named $1. A key that sends
# several bytes (arrow and function keys send an escape sequence) counts as
# one press: the rest is drained. Otherwise each byte would act as a key and
# start or stop further recordings.
read_key() {
  local -n key_ref=$1
  local -- rest
  # shellcheck disable=SC2034 # key_ref is a nameref: this sets the caller's variable
  read -rsn1 key_ref || return 1
  # shellcheck disable=SC2034 # rest only absorbs the drained bytes
  while read -rsn1 -t 0.05 rest; do :; done
}

run_recording_loop() {
  local -- prefix=$1
  local -- key='' wav_file txt_file cmd
  # vrecord's default verbosity matches ours; -v would add its debug output
  local -a verbose_flag=()
  ((VERBOSE)) || verbose_flag=(-q)

  while :; do
    # Start recording with transcription enabled
    RECORDING=1
    vrecord start -t "${verbose_flag[@]}" "$prefix" || die 1 'vrecord start failed'

    # Wait for any key
    info 'Recording... Press any key to stop (q to quit)'
    # Guard the read: on EOF / Ctrl-D, stop the active recording instead of
    # letting set -e abort and orphan ffmpeg.
    if ! read_key key; then
      >&2 echo
      warn 'Input closed - stopping recording and exiting.'
      vrecord stop "${verbose_flag[@]}" >/dev/null \
        || error 'Could not stop the recording. Run "vrecord stop".'
      RECORDING=0
      break
    fi
    >&2 echo

    # Stop and transcribe. vrecord prints the saved WAV path on stdout; the
    # transcript (transcribe writes <stem>.txt) is derived from it, never
    # guessed from a directory listing, which could pick a stale transcript.
    wav_file=$(vrecord stop "${verbose_flag[@]}") || die 1 'vrecord stop failed'
    RECORDING=0
    txt_file=''
    [[ -z "$wav_file" ]] || txt_file=${wav_file%.wav}.txt

    if [[ -n "$txt_file" && -f "$txt_file" ]]; then
      info '--- Transcription ---'
      cat -- "$txt_file"
      >&2 echo
    else
      warn 'No transcription was produced for this recording.'
    fi

    # Optional: call external program with transcription. CALL_APP is the
    # user's own shell command, so bash runs it, under the caller's PATH; the
    # transcript reaches it only as data ($1 or stdin), never as command text.
    if [[ -n "$CALL_APP" && -n "$txt_file" && -f "$txt_file" ]]; then
      if [[ "$CALL_APP" == *'{{FILE}}'* ]]; then
        # Template mode: {{FILE}}, bare or quoted, becomes "$1"
        cmd=${CALL_APP//\"\{\{FILE\}\}\"/\{\{FILE\}\}}
        cmd=${cmd//\'\{\{FILE\}\}\'/\{\{FILE\}\}}
        cmd=${cmd//\{\{FILE\}\}/\"\$1\"}
        info "Running: ${CALL_APP//\{\{FILE\}\}/$txt_file}"
        env PATH="$CALLER_PATH" "$BASH" -c -- "$cmd" "$SCRIPT_NAME" "$txt_file" \
          || error 'CALL_APP command failed'
      else
        # Default: pipe transcription via stdin
        info "Piping to: $CALL_APP"
        env PATH="$CALLER_PATH" "$BASH" -c -- "$CALL_APP" "$SCRIPT_NAME" < "$txt_file" \
          || error 'CALL_APP command failed'
      fi
    fi

    # Exit on 'q'
    if [[ "${key,,}" == q ]]; then
      info 'Exiting'
      break
    fi

    info '--- Press Enter to start next recording, or q to quit ---'
    if ! read_key key; then
      >&2 echo
      info 'Input closed - exiting.'
      break
    fi
    >&2 echo
    if [[ "${key,,}" == q ]]; then
      info 'Exiting'
      break
    fi
  done
}

main() {
  local -- prefix=''

  while (($#)); do
    case $1 in
      -C|--call)     noarg "$@"; shift; CALL_APP=$1;;
      -v|--verbose)  VERBOSE=1 ;;
      -q|--quiet)    VERBOSE=0 ;;
      -V|--version)  echo "$SCRIPT_NAME $VERSION"; return 0 ;;
      -h|--help)     show_help; return 0 ;;
      -[vqVh]?*)     set -- "${1:0:2}" "-${1:2}" "${@:2}"; continue ;;
      --)            shift; break ;;
      -*)            die 22 "Invalid option ${1@Q}" ;;
      *)             [[ -z $prefix ]] || die 2 "Unexpected argument ${1@Q}"
                     prefix=$1 ;;
    esac
    shift
  done
  # Whatever follows -- is the prefix, even if it starts with a dash
  if (($#)); then
    [[ -z $prefix ]] || die 2 "Unexpected argument ${1@Q}"
    (($# == 1)) || die 2 "Unexpected argument ${2@Q}"
    prefix=$1
  fi
  [[ -n "$prefix" ]] || prefix=voice

  readonly -- VERBOSE CALL_APP

  check_prerequisites
  check_not_recording
  validate_prefix "$prefix"
  trap 'on_signal 130' INT
  trap 'on_signal 143' TERM
  run_recording_loop "$prefix"
}

main "$@"
#fin
